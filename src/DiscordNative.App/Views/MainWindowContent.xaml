                                                                                <FontIcon Glyph="&#xE76E;" FontSize="13" Foreground="#B5BAC1" />
                                                                            </Button>
                                                                        </Grid>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </Flyout>
                                                    </Button.Flyout>

                                                    <!-- Affichage du membre dans la liste -->
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <Grid Width="32" Height="32" PointerEntered="OnAvatarPointerEntered" PointerExited="OnAvatarPointerExited">
                                                            <Ellipse Fill="{ThemeResource ControlFillColorSecondaryBrush}" />
                                                            <Ellipse>
                                                                <Ellipse.Fill>
                                                                    <ImageBrush ImageSource="{x:Bind AvatarUrl, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                                </Ellipse.Fill>
                                                            </Ellipse>
                                                            <Ellipse Width="10" Height="10" Fill="{x:Bind StatusColor, Mode=OneWay}"
                                                                     Stroke="{ThemeResource ApplicationPageBackgroundThemeBrush}" StrokeThickness="2"
                                                                     HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                                        </Grid>
                                                        <StackPanel VerticalAlignment="Center" MaxWidth="150">
                                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                <TextBlock Text="{x:Bind DisplayName}" FontSize="13" FontWeight="Medium" Foreground="#F2F3F5" TextTrimming="CharacterEllipsis" MaxWidth="110" />
                                                                <!-- Tag de Clan (ex: 🐱 illit) -->
                                                                <Border Visibility="{x:Bind HasClan, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                        Background="#2b2d31" CornerRadius="4" Padding="4,1" VerticalAlignment="Center">
                                                                    <StackPanel Orientation="Horizontal" Spacing="2">
                                                                        <Image Width="10" Height="10" Source="{x:Bind ClanBadgeUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" Stretch="Uniform" />
                                                                        <TextBlock Text="{x:Bind ClanTag, Mode=OneWay}" FontSize="9" FontWeight="Bold" Foreground="#DBDEE1" />
                                                                    </StackPanel>
                                                                </Border>
                                                                <!-- Badge Bot -->
                                                                <Border Visibility="{x:Bind Bot, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                        Background="#5865F2" CornerRadius="3" Padding="4,1" VerticalAlignment="Center">
                                                                    <TextBlock Text="APP" FontSize="9" FontWeight="Bold" Foreground="White" />
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Text="{x:Bind ActivitySummaryText, Mode=OneWay}" FontSize="11" Foreground="#23A55A" TextTrimming="CharacterEllipsis"
                                                                       Visibility="{x:Bind HasActivityOrCustomStatus, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>

                                <!-- 3. SECTION HORS LIGNE -->
                                <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.HasOfflineMembers, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="6,8,6,4">
                                        <TextBlock Text="HORS LIGNE" FontSize="11" FontWeight="Bold" Foreground="#949BA4" />
                                        <TextBlock Text="—" FontSize="11" FontWeight="Bold" Foreground="#949BA4" />
                                        <TextBlock Text="{x:Bind ViewModel.OfflineMembersCount, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="#949BA4" />
                                    </StackPanel>

                                    <ItemsControl ItemsSource="{x:Bind ViewModel.OfflineMembers, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:DiscordUser">
                                                <Button Background="Transparent" BorderThickness="0" HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Left" Padding="6,5" CornerRadius="8" Opacity="0.65"
                                                        Tag="{x:Bind}" Click="OnMemberItemClicked" DoubleTapped="OnMemberItemDoubleTapped"
                                                        ToolTipService.ToolTip="{x:Bind DisplayName}">
                                                    <Button.Flyout>
                                                        <Flyout Opening="OnUserProfileFlyoutOpening" Placement="LeftEdgeAlignedTop">
                                                            <Flyout.FlyoutPresenterStyle>
                                                                <Style TargetType="FlyoutPresenter">
                                                                    <Setter Property="Padding" Value="0" />
                                                                    <Setter Property="CornerRadius" Value="16" />
                                                                    <Setter Property="MaxWidth" Value="340" />
                                                                    <Setter Property="MaxHeight" Value="620" />
                                                                    <Setter Property="Background" Value="Transparent" />
                                                                    <Setter Property="BorderThickness" Value="0" />
                                                                </Style>
                                                            </Flyout.FlyoutPresenterStyle>
                                                            <!-- Carte Popout de l'utilisateur hors-ligne -->
                                                            <Border Width="330" CornerRadius="16"
                                                                    Background="#1e1f22"
                                                                    BorderBrush="#35373c"
                                                                    BorderThickness="1"
                                                                    Tag="{x:Bind}">
                                                                <Grid>
                                                                    <Border Height="110" VerticalAlignment="Top" CornerRadius="15,15,0,0">
                                                                        <Border.Background>
                                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                                <GradientStop Color="{x:Bind ProfilePrimaryColorHex, Mode=OneWay}" Offset="0.0" />
                                                                                <GradientStop Color="{x:Bind ProfileSecondaryColorHex, Mode=OneWay}" Offset="1.0" />
                                                                            </LinearGradientBrush>
                                                                        </Border.Background>
                                                                        <Grid>
                                                                            <Border CornerRadius="15,15,0,0"
                                                                                    Visibility="{x:Bind HasBanner, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                                <Border.Background>
                                                                                    <ImageBrush ImageSource="{x:Bind BannerUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}"
                                                                                                Stretch="UniformToFill" AlignmentY="Center" AlignmentX="Center" />
                                                                                </Border.Background>
                                                                            </Border>
                                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" Spacing="6">
                                                                                <Button Width="30" Height="30" Padding="0" CornerRadius="15"
                                                                                        Background="#66000000" BorderThickness="0"
                                                                                        ToolTipService.ToolTip="Ajouter en ami"
                                                                                        Tag="{x:Bind}" Click="OnAddFriendFromPopoutClicked">
                                                                                    <FontIcon Glyph="&#xE8FA;" FontSize="13" Foreground="#FFFFFF" />
                                                                                </Button>
                                                                                <Button Width="30" Height="30" Padding="0" CornerRadius="15"
                                                                                        Background="#66000000" BorderThickness="0"
                                                                                        ToolTipService.ToolTip="Plus d'options">
                                                                                    <Button.Flyout>
                                                                                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                                                            <MenuFlyoutItem Text="Voir le profil complet" Tag="{x:Bind}" Click="OnViewFullProfileFromPopoutClicked">
                                                                                                <MenuFlyoutItem.Icon>
                                                                                                    <FontIcon Glyph="&#xE77B;" />
                                                                                                </MenuFlyoutItem.Icon>
                                                                                            </MenuFlyoutItem>
                                                                                            <MenuFlyoutItem Text="Partager le profil" Tag="{x:Bind}" Click="OnShareProfileFromPopoutClicked">
                                                                                                <MenuFlyoutItem.Icon>
                                                                                                    <FontIcon Glyph="&#xE72D;" />
                                                                                                </MenuFlyoutItem.Icon>
                                                                                            </MenuFlyoutItem>
                                                                                            <MenuFlyoutItem Text="Shop This Look">
                                                                                                <MenuFlyoutItem.Icon>
                                                                                                    <FontIcon Glyph="&#xE719;" />
                                                                                                </MenuFlyoutItem.Icon>
                                                                                            </MenuFlyoutItem>
                                                                                            <MenuFlyoutItem Text="Inviter sur le serveur" Tag="{x:Bind}" Click="OnInviteUserToGuildClicked">
                                                                                                <MenuFlyoutItem.Icon>
                                                                                                    <FontIcon Glyph="&#xE8FA;" />
                                                                                                </MenuFlyoutItem.Icon>
                                                                                            </MenuFlyoutItem>
                                                                                            <MenuFlyoutSeparator />
                                                                                            <MenuFlyoutItem Text="Ignorer" Tag="{x:Bind}" Click="OnIgnoreUserClicked">
                                                                                                <MenuFlyoutItem.Icon>
                                                                                                    <FontIcon Glyph="&#xE7BA;" />
                                                                                                </MenuFlyoutItem.Icon>
                                                                                            </MenuFlyoutItem>
                                                                                            <MenuFlyoutItem Text="Bloquer" Foreground="#F23F43" Tag="{x:Bind}" Click="OnBlockUserFromPopoutClicked">
                                                                                                <MenuFlyoutItem.Icon>
                                                                                                    <FontIcon Glyph="&#xE72B;" Foreground="#F23F43" />
                                                                                                </MenuFlyoutItem.Icon>
                                                                                            </MenuFlyoutItem>
                                                                                            <MenuFlyoutItem Text="Signaler le profil d'utilisateur" Foreground="#F23F43" Tag="{x:Bind}" Click="OnReportUserClicked">
                                                                                                <MenuFlyoutItem.Icon>
                                                                                                    <FontIcon Glyph="&#xE730;" Foreground="#F23F43" />
                                                                                                </MenuFlyoutItem.Icon>
                                                                                            </MenuFlyoutItem>
                                                                                            <MenuFlyoutSeparator />
                                                                                            <MenuFlyoutItem Text="Copier l'identifiant" Tag="{x:Bind}" Click="OnCopyUserIdFromPopoutClicked">
                                                                                                <MenuFlyoutItem.Icon>
                                                                                                    <FontIcon Glyph="&#xE8C8;" />
                                                                                                </MenuFlyoutItem.Icon>
                                                                                            </MenuFlyoutItem>
                                                                                        </MenuFlyout>
                                                                                    </Button.Flyout>
                                                                                    <FontIcon Glyph="&#xE712;" FontSize="13" Foreground="#FFFFFF" />
                                                                                </Button>
                                                                            </StackPanel>
                                                                        </Grid>
                                                                    </Border>

                                                                    <!-- Avatar + Pastille -->
                                                                    <Grid Margin="16,68,16,0" VerticalAlignment="Top">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="*" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <Grid Grid.Column="0" Width="82" Height="82">
                                                                            <Ellipse Fill="#1e1f22" Stroke="#1e1f22" StrokeThickness="4" />
                                                                            <Ellipse Width="76" Height="76">
                                                                                <Ellipse.Fill>
                                                                                    <ImageBrush ImageSource="{x:Bind AvatarUrl, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                                                </Ellipse.Fill>
                                                                            </Ellipse>
                                                                            <Ellipse Width="22" Height="22" Fill="{x:Bind StatusColor, Mode=OneWay}"
                                                                                     Stroke="#1e1f22" StrokeThickness="4"
                                                                                     HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                                                        </Grid>
                                                                        <Border Grid.Column="1" Margin="8,24,0,0" VerticalAlignment="Center"
                                                                                Background="#111214" BorderBrush="#383A40" BorderThickness="1"
                                                                                CornerRadius="14" Padding="10,6"
                                                                                Visibility="{x:Bind HasCustomStatus, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                            <TextBlock Text="{x:Bind CustomStatusText, Mode=OneWay}"
                                                                                       Foreground="#F2F3F5" FontSize="11" FontWeight="Medium"
                                                                                       TextTrimming="CharacterEllipsis" MaxWidth="165" />
                                                                        </Border>
                                                                    </Grid>

                                                                    <!-- Corps du profil -->
                                                                    <StackPanel Margin="16,156,16,14" Spacing="8">
                                                                        <Grid>
                                                                            <TextBlock Text="{x:Bind DisplayName}" FontSize="18" FontWeight="Bold" Foreground="#F2F3F5" TextTrimming="CharacterEllipsis" Margin="0,0,26,0" />
                                                                            <Button HorizontalAlignment="Right" VerticalAlignment="Center" Padding="4" Background="Transparent" BorderThickness="0" CornerRadius="4" ToolTipService.ToolTip="Note sur l'utilisateur">
                                                                                <FontIcon Glyph="&#xE70F;" FontSize="13" Foreground="#B5BAC1" />
                                                                            </Button>
                                                                        </Grid>

                                                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                            <TextBlock Text="{x:Bind UserTag}" FontSize="12" Foreground="#B5BAC1" FontWeight="Normal" />
                                                                            <ItemsControl ItemsSource="{x:Bind Badges, Mode=OneWay}" VerticalAlignment="Center"
                                                                                          Visibility="{x:Bind HasBadges, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                                <ItemsControl.ItemsPanel>
                                                                                    <ItemsPanelTemplate>
                                                                                        <StackPanel Orientation="Horizontal" Spacing="4" />
                                                                                    </ItemsPanelTemplate>
                                                                                </ItemsControl.ItemsPanel>
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate x:DataType="models:DiscordBadge">
                                                                                        <Image Width="16" Height="16" Source="{x:Bind IconUrl, Converter={StaticResource StringToImageSourceConverter}}"
                                                                                               ToolTipService.ToolTip="{x:Bind Description}" Stretch="Uniform" />
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                        </StackPanel>

                                                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                                                                                    Visibility="{x:Bind HasMutualInfo, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                            <FontIcon Glyph="&#xE716;" FontSize="12" Foreground="#B5BAC1" />
                                                                            <TextBlock Text="{x:Bind MutualSummaryText, Mode=OneWay}" FontSize="11" Foreground="#B5BAC1" FontWeight="Medium" />
                                                                        </StackPanel>

                                                                        <TextBlock Text="{x:Bind AboutMe, Mode=OneWay}" FontSize="12" Foreground="#DBDEE1" TextWrapping="Wrap" Opacity="0.9" />

                                                                        <StackPanel Spacing="4" Visibility="{x:Bind HasDisplayRoles, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                            <TextBlock Text="RÔLES" FontSize="10" FontWeight="Bold" Foreground="#949BA4" />
                                                                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                                                                          HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                                                                                <ItemsControl ItemsSource="{x:Bind DisplayRoles, Mode=OneWay}">
                                                                                    <ItemsControl.ItemsPanel>
                                                                                        <ItemsPanelTemplate>
                                                                                            <StackPanel Orientation="Horizontal" Spacing="4" />
                                                                                        </ItemsPanelTemplate>
                                                                                    </ItemsControl.ItemsPanel>
                                                                                    <ItemsControl.ItemTemplate>
                                                                                        <DataTemplate x:DataType="models:DiscordRole">
                                                                                            <Border Background="#2b2d31" BorderBrush="#35373c" BorderThickness="1" CornerRadius="6" Padding="6,3">
                                                                                                <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                                                                    <Ellipse Width="8" Height="8" Fill="{x:Bind ColorHex}" VerticalAlignment="Center" />
                                                                                                    <TextBlock Text="{x:Bind Name}" FontSize="11" FontWeight="SemiBold" Foreground="#F2F3F5" VerticalAlignment="Center" />
                                                                                                </StackPanel>
                                                                                            </Border>
                                                                                        </DataTemplate>
                                                                                    </ItemsControl.ItemTemplate>
                                                                                </ItemsControl>
                                                                            </ScrollViewer>
                                                                        </StackPanel>

                                                                        <Grid Margin="0,4,0,0">
                                                                            <TextBox PlaceholderText="{x:Bind QuickMessagePlaceholder, Mode=OneWay}"
                                                                                     Tag="{x:Bind}"
                                                                                     KeyDown="OnQuickProfileMessageKeyDown"
                                                                                     Background="#111214" Foreground="#F2F3F5"
                                                                                     BorderBrush="#383A40" BorderThickness="1"
                                                                                     CornerRadius="8" Padding="10,6,34,6" FontSize="12" />
                                                                            <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                                    Margin="0,0,4,0" Padding="4"
                                                                                    Background="Transparent" BorderThickness="0" CornerRadius="6"
                                                                                    ToolTipService.ToolTip="Émojis">
                                                                                <FontIcon Glyph="&#xE76E;" FontSize="13" Foreground="#B5BAC1" />
                                                                            </Button>
                                                                        </Grid>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>
                                                        </Flyout>
                                                    </Button.Flyout>

                                                    <!-- Affichage membre hors ligne -->
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <Grid Width="32" Height="32">
                                                            <Ellipse Fill="{ThemeResource ControlFillColorSecondaryBrush}" />
                                                            <Ellipse>
                                                                <Ellipse.Fill>
                                                                    <ImageBrush ImageSource="{x:Bind AvatarUrl, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                                </Ellipse.Fill>
                                                            </Ellipse>
                                                            <Ellipse Width="10" Height="10" Fill="{x:Bind StatusColor, Mode=OneWay}"
                                                                     Stroke="{ThemeResource ApplicationPageBackgroundThemeBrush}" StrokeThickness="2"
                                                                     HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                                        </Grid>
                                                        <StackPanel VerticalAlignment="Center" MaxWidth="150">
                                                            <TextBlock Text="{x:Bind DisplayName}" FontSize="13" FontWeight="Medium" Foreground="#949BA4" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Barre de saisie de message (avec bannière Réponse/Édition, Collage Presse-papiers & Sélecteur d'Emojis) -->
                    <StackPanel Grid.Row="2" Grid.Column="0" Visibility="{x:Bind ViewModel.TextViewVisibility, Mode=OneWay}" Padding="16,0,16,16" Spacing="6">
                        <!-- Bannière Réponse ou Modification en cours -->
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="12,6"
                                Visibility="{x:Bind ViewModel.ComposerBannerVisibility, Mode=OneWay}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind ViewModel.ComposerBannerText, Mode=OneWay}"
                                           FontSize="12" FontWeight="SemiBold" Opacity="0.85"
                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <Button Grid.Column="1" Padding="6,2" CornerRadius="6"
                                        Background="Transparent" BorderThickness="0"
                                        Click="OnCancelComposerActionClicked" ToolTipService.ToolTip="Annuler">
                                    <FontIcon Glyph="&#xE711;" FontSize="10" />
                                </Button>
                            </Grid>
                        </Border>

                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Width="40" Height="40" CornerRadius="20" Padding="0"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}" BorderThickness="0"
                                    Click="OnAttachFileClicked" ToolTipService.ToolTip="Joindre un fichier ou une image">
                                <FontIcon Glyph="&#xE710;" FontSize="16" />
                            </Button>

                            <Button Grid.Column="1" Width="40" Height="40" CornerRadius="20" Padding="0"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}" BorderThickness="0"
                                    Click="OnPasteClipboardAttachmentClicked" ToolTipService.ToolTip="Envoyer l'image du presse-papiers">
                                <FontIcon Glyph="&#xE77F;" FontSize="15" />
                            </Button>

                            <Button Grid.Column="2" Width="40" Height="40" CornerRadius="20" Padding="0"
                                    Background="{ThemeResource ControlFillColorDefaultBrush}" BorderThickness="0"
                                    Click="OnCreatePollClicked" ToolTipService.ToolTip="Créer un sondage Discord">
                                <FontIcon Glyph="&#xE9D9;" FontSize="15" />
                            </Button>

                            <TextBox Grid.Column="3" x:Name="MessageInput"
                                     PlaceholderText="Écrire un message... ( >4000 car. converti en message.txt )"
                                     CornerRadius="10" BorderThickness="0"
                                     Background="{ThemeResource ControlFillColorDefaultBrush}"
                                     Padding="14,10"
                                     TextChanged="OnMessageInputTextChanged"
                                     KeyDown="OnMessageInputKeyDown" />

                            <!-- Sélecteur d'Emojis rapide -->
                            <Button Grid.Column="4" Width="40" Height="40" CornerRadius="20" Padding="0"
                                     Background="{ThemeResource ControlFillColorDefaultBrush}" BorderThickness="0"
                                     ToolTipService.ToolTip="Insérer un émoji">
                                <FontIcon Glyph="&#xED54;" FontSize="16" />
                                <Button.Flyout>
                                    <Flyout Placement="Top">
                                        <StackPanel Width="260" Spacing="8">
                                            <TextBlock Text="Émojis rapides" FontWeight="SemiBold" FontSize="13" />
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Button Content="😀" Click="OnQuickEmojiInsertClicked" />
                                                <Button Content="😂" Click="OnQuickEmojiInsertClicked" />
                                                <Button Content="🥹" Click="OnQuickEmojiInsertClicked" />
                                                <Button Content="😍" Click="OnQuickEmojiInsertClicked" />
                                                <Button Content="😎" Click="OnQuickEmojiInsertClicked" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Button Content="👍" Click="OnQuickEmojiInsertClicked" />
                                                <Button Content="❤️" Click="OnQuickEmojiInsertClicked" />
                                                <Button Content="🔥" Click="OnQuickEmojiInsertClicked" />
                                                <Button Content="🎉" Click="OnQuickEmojiInsertClicked" />
                                                <Button Content="💯" Click="OnQuickEmojiInsertClicked" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Button Content="🤔" Click="OnQuickEmojiInsertClicked" />
                                                <Button Content="😭" Click="OnQuickEmojiInsertClicked" />
                                                <Button Content="🙏" Click="OnQuickEmojiInsertClicked" />
                                                <Button Content="👀" Click="OnQuickEmojiInsertClicked" />
                                                <Button Content="🚀" Click="OnQuickEmojiInsertClicked" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>

                            <Button Grid.Column="5" Content="Envoyer" Click="OnSendClicked"
                                    CornerRadius="10"
                                    Style="{StaticResource AccentButtonStyle}" />
                        </Grid>
                    </StackPanel>

                </Grid>
            </Grid>
        </Grid>

        <!-- Vue Complète du Profil (Full User Profile Modal) 100% fidèle à Discord (media_1792268309402_4ba614ad.png) -->
        <Grid x:Name="FullUserProfileOverlay" Visibility="Collapsed" Background="#B8000000" Canvas.ZIndex="880"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
              PointerPressed="OnFullUserProfileBackdropPointerPressed">
            <Border Width="880" Height="620" CornerRadius="20"
                    BorderBrush="#35373C" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    PointerPressed="OnFullUserProfileModalContainerPointerPressed">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="{x:Bind FullProfileUser.ProfilePrimaryColorHex, Mode=OneWay}" Offset="0.0" />
                        <GradientStop Color="{x:Bind FullProfileUser.ProfileSecondaryColorHex, Mode=OneWay}" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <!-- Bouton Fermer (X) en haut à droite -->
                    <Button Width="36" Height="36" Padding="0" CornerRadius="18"
                            Background="#40000000" BorderThickness="0"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,16,16,0" Canvas.ZIndex="10"
                            Click="OnCloseFullUserProfileClicked" ToolTipService.ToolTip="Fermer (Échap)">
                        <FontIcon Glyph="&#xE8BB;" FontSize="14" Foreground="White" />
                    </Button>

                    <Grid Margin="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="330" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- COLONNE GAUCHE (Identité de l'utilisateur) -->
                        <Border Grid.Column="0" Background="#28000000" CornerRadius="16" Padding="0" Margin="0,0,12,0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel Spacing="0">
                                    <!-- Bannière de profil avec coins arrondis -->
                                    <Grid Height="125">
                                        <Border CornerRadius="16,16,0,0"
                                                Background="{x:Bind FullProfileUser.ProfilePrimaryColorHex, Mode=OneWay}">
                                            <Border CornerRadius="16,16,0,0"
                                                    Visibility="{x:Bind FullProfileUser.HasBanner, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <Border.Background>
                                                    <ImageBrush ImageSource="{x:Bind FullProfileUser.BannerUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}"
                                                                Stretch="UniformToFill" AlignmentY="Center" AlignmentX="Center" />
                                                </Border.Background>
                                            </Border>
                                        </Border>

                                        <!-- Avatar rond avec bordure épaisse assortie (Cliquer pour zoomer en plein écran) -->
                                        <Button Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="45"
                                                Width="90" Height="90" Margin="16,74,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                Click="OnZoomAvatarClicked" ToolTipService.ToolTip="Cliquer pour afficher la photo de profil en grand">
                                            <Ellipse Width="90" Height="90"
                                                     StrokeThickness="6" Stroke="{x:Bind FullProfileUser.ProfilePrimaryColorHex, Mode=OneWay}">
                                                <Ellipse.Fill>
                                                    <ImageBrush ImageSource="{x:Bind FullProfileUser.AvatarUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                </Ellipse.Fill>
                                            </Ellipse>
                                        </Button>

                                        <!-- Pastille de statut sur l'avatar -->
                                        <Ellipse Width="22" Height="22" Margin="80,138,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                 Fill="{x:Bind FullProfileUser.StatusColor, Mode=OneWay}"
                                                 Stroke="{x:Bind FullProfileUser.ProfilePrimaryColorHex, Mode=OneWay}" StrokeThickness="4" />

                                        <!-- Bulle de statut personnalisé (pensée) à droite de l'avatar -->
                                        <Border Margin="116,110,14,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                Background="#30000000" CornerRadius="16" Padding="12,6"
                                                Visibility="{x:Bind FullProfileUser.HasCustomStatus, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="{x:Bind FullProfileUser.CustomStatusText, Mode=OneWay}"
                                                       Foreground="White" FontSize="12" FontWeight="Medium"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="180" />
                                        </Border>
                                    </Grid>

                                    <!-- Informations sous la bannière -->
                                    <StackPanel Margin="16,46,16,16" Spacing="10">
                                        <!-- Nom d'affichage en très grand -->
                                        <TextBlock Text="{x:Bind FullProfileUser.DisplayName, Mode=OneWay}"
                                                   Foreground="{x:Bind FullProfileUser.ProfileTextForegroundColorHex, Mode=OneWay}"
                                                   FontWeight="Bold" FontSize="22" TextTrimming="CharacterEllipsis" />

                                        <!-- Username + Clan pill [✨ yuki] + Badges officiels -->
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Bind FullProfileUser.UserTag, Mode=OneWay}"
                                                       Foreground="{x:Bind FullProfileUser.ProfileTextForegroundColorHex, Mode=OneWay}"
                                                       Opacity="0.75" FontSize="13" VerticalAlignment="Center" />

                                            <!-- Tag Clan (ex: [✨ yuki]) -->
                                            <Border Background="#33FFFFFF" CornerRadius="8" Padding="6,2" VerticalAlignment="Center"
                                                    Visibility="{x:Bind FullProfileUser.HasClan, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <StackPanel Orientation="Horizontal" Spacing="4">
                                                    <Image Width="12" Height="12" Source="{x:Bind FullProfileUser.ClanBadgeUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" Stretch="Uniform" />
                                                    <TextBlock Text="{x:Bind FullProfileUser.ClanTag, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Badges -->
                                            <ItemsControl ItemsSource="{x:Bind FullProfileUser.Badges, Mode=OneWay}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:DiscordBadge">
                                                        <Image Width="16" Height="16" Source="{x:Bind IconUrl, Converter={StaticResource StringToImageSourceConverter}}"
                                                               ToolTipService.ToolTip="{x:Bind Description}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>

                                        <!-- Boutons d'action (Add Friend, Message, ...) -->
                                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,4">
                                            <Button Content="Demande d'ami" Style="{StaticResource AccentButtonStyle}"
                                                    CornerRadius="8" Padding="14,6" Height="34"
                                                    Click="OnAddFriendFromProfileClicked" />
                                            <Button Width="36" Height="34" Padding="0" CornerRadius="8" Background="#33FFFFFF" BorderThickness="0"
                                                    Click="OnSendMessageFromProfileClicked" ToolTipService.ToolTip="Envoyer un message privé">
                                                <FontIcon Glyph="&#xE8BD;" FontSize="15" Foreground="White" />
                                            </Button>
                                            <Button Width="36" Height="34" Padding="0" CornerRadius="8" Background="#33FFFFFF" BorderThickness="0"
                                                    Click="OnProfileMoreActionsClicked" ToolTipService.ToolTip="Autres actions">
                                                <FontIcon Glyph="&#xE10C;" FontSize="15" Foreground="White" />
                                            </Button>
                                        </StackPanel>

                                        <!-- Ligne de séparation -->
                                        <Border Height="1" Background="#25FFFFFF" Margin="0,4" />

                                        <!-- Bio / About Me -->
                                        <TextBlock Text="{x:Bind FullProfileUser.AboutMe, Mode=OneWay}"
                                                   Foreground="{x:Bind FullProfileUser.ProfileTextForegroundColorHex, Mode=OneWay}"
                                                   TextWrapping="Wrap" FontSize="13" Opacity="0.9" />

                                        <!-- Ligne de séparation -->
                                        <Border Height="1" Background="#25FFFFFF" Margin="0,4" />

                                        <!-- Section Member Since -->
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="MEMBRE DEPUIS" FontSize="11" FontWeight="Bold" Opacity="0.65" Foreground="{x:Bind FullProfileUser.ProfileTextForegroundColorHex, Mode=OneWay}" />
                                            <TextBlock Text="{x:Bind FullProfileUser.MemberSinceText, Mode=OneWay}" FontSize="13" FontWeight="Medium" Foreground="{x:Bind FullProfileUser.ProfileTextForegroundColorHex, Mode=OneWay}" />
                                        </StackPanel>

                                        <!-- Ligne de séparation -->
                                        <Border Height="1" Background="#25FFFFFF" Margin="0,4" />

                                        <!-- Section Note -->
                                        <StackPanel Spacing="3">
                                            <TextBlock Text="NOTE (VISIBLE UNIQUEMENT PAR VOUS)" FontSize="11" FontWeight="Bold" Opacity="0.65" Foreground="{x:Bind FullProfileUser.ProfileTextForegroundColorHex, Mode=OneWay}" />
                                            <TextBox x:Name="ProfileUserNoteTextBox" PlaceholderText="Cliquez pour ajouter une note"
                                                     Background="Transparent" BorderThickness="0" Padding="0" FontSize="12"
                                                     Foreground="{x:Bind FullProfileUser.ProfileTextForegroundColorHex, Mode=OneWay}"
                                                     LostFocus="OnProfileUserNoteLostFocus" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- COLONNE DROITE (Onglets : Board, Activity, Wishlist, Mutuals) -->
                        <Grid Grid.Column="1" Margin="8,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Barre d'onglets façon Discord -->
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="16" Margin="4,0,0,12">
                                <!-- Onglet Board -->
                                <StackPanel Spacing="4">
                                    <Button Content="Board" Background="Transparent" BorderThickness="0" Padding="4,4"
                                            FontSize="14" FontWeight="SemiBold" Foreground="White"
                                            Tag="Board" Click="OnProfileTabClicked" />
                                    <Border x:Name="ProfileBoardTabIndicator" Height="2" Background="White" CornerRadius="1" />
                                </StackPanel>

                                <!-- Onglet Activity -->
                                <StackPanel Spacing="4">
                                    <Button Content="Activity" Background="Transparent" BorderThickness="0" Padding="4,4"
                                            FontSize="14" FontWeight="SemiBold" Foreground="White" Opacity="0.75"
                                            Tag="Activity" Click="OnProfileTabClicked" />
                                    <Border x:Name="ProfileActivityTabIndicator" Height="2" Background="White" CornerRadius="1" Visibility="Collapsed" />
                                </StackPanel>

                                <!-- Onglet Wishlist -->
                                <StackPanel Spacing="4">
                                    <Button Content="Wishlist" Background="Transparent" BorderThickness="0" Padding="4,4"
                                            FontSize="14" FontWeight="SemiBold" Foreground="White" Opacity="0.75"
                                            Tag="Wishlist" Click="OnProfileTabClicked" />
                                    <Border x:Name="ProfileWishlistTabIndicator" Height="2" Background="White" CornerRadius="1" Visibility="Collapsed" />
                                </StackPanel>

                                <!-- Onglet Amis en commun -->
                                <StackPanel Spacing="4" Visibility="{x:Bind FullProfileUser.HasMutualInfo, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Button Content="{x:Bind FullProfileUser.MutualSummaryText, Mode=OneWay}" Background="Transparent" BorderThickness="0" Padding="4,4"
                                            FontSize="14" FontWeight="SemiBold" Foreground="White" Opacity="0.75"
                                            Tag="Mutuals" Click="OnProfileTabClicked" />
                                    <Border x:Name="ProfileMutualsTabIndicator" Height="2" Background="White" CornerRadius="1" Visibility="Collapsed" />
                                </StackPanel>
                            </StackPanel>

                            <!-- CONTENU DES ONGLETS -->
                            <Grid Grid.Row="1">
                                <!-- CONTENU ONGLET 1 : BOARD (Games I Like - 2x4 Grid) -->
                                <ScrollViewer x:Name="ProfileBoardContent" VerticalScrollBarVisibility="Auto">
                                    <Border Background="#25000000" CornerRadius="16" Padding="16" Margin="0,0,4,0">
                                        <StackPanel Spacing="12">
                                            <Grid>
                                                <TextBlock Text="Games I Like" FontSize="15" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                                                <Button Width="28" Height="28" Padding="0" Background="Transparent" BorderThickness="0"
                                                        HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <FontIcon Glyph="&#xE10C;" FontSize="13" Foreground="White" Opacity="0.75" />
                                                </Button>
                                            </Grid>

                                            <!-- Grille 2x4 des 8 affiches de jeux (Valorant, osu!, Silent Hill f, Overwatch, Life is Strange, Apex Legends, Saya no Uta, Roblox) -->
                                            <Grid HorizontalAlignment="Center">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Ligne 1 -->
                                                <Border Grid.Row="0" Grid.Column="0" Width="105" Height="142" CornerRadius="10" Margin="5"
                                                        Background="#20000000" ToolTipService.ToolTip="VALORANT">
                                                    <Image Source="ms-appx:///Assets/Games/valorant.png" Stretch="UniformToFill" />
                                                </Border>
                                                <Border Grid.Row="0" Grid.Column="1" Width="105" Height="142" CornerRadius="10" Margin="5"
                                                        Background="#20000000" ToolTipService.ToolTip="osu!">
                                                    <Image Source="ms-appx:///Assets/Games/osu.png" Stretch="UniformToFill" />
                                                </Border>
                                                <Border Grid.Row="0" Grid.Column="2" Width="105" Height="142" CornerRadius="10" Margin="5"
                                                        Background="#20000000" ToolTipService.ToolTip="SILENT HILL f">
                                                    <Image Source="ms-appx:///Assets/Games/silenthill.png" Stretch="UniformToFill" />
                                                </Border>
                                                <Border Grid.Row="0" Grid.Column="3" Width="105" Height="142" CornerRadius="10" Margin="5"
                                                        Background="#20000000" ToolTipService.ToolTip="OVERWATCH">
                                                    <Image Source="ms-appx:///Assets/Games/overwatch.png" Stretch="UniformToFill" />
                                                </Border>

                                                <!-- Ligne 2 -->
                                                <Border Grid.Row="1" Grid.Column="0" Width="105" Height="142" CornerRadius="10" Margin="5"
                                                        Background="#20000000" ToolTipService.ToolTip="LIFE IS STRANGE">
                                                    <Image Source="ms-appx:///Assets/Games/lifeisstrange.png" Stretch="UniformToFill" />
                                                </Border>
                                                <Border Grid.Row="1" Grid.Column="1" Width="105" Height="142" CornerRadius="10" Margin="5"
                                                        Background="#20000000" ToolTipService.ToolTip="APEX LEGENDS">
                                                    <Image Source="ms-appx:///Assets/Games/apex.png" Stretch="UniformToFill" />
                                                </Border>
                                                <Border Grid.Row="1" Grid.Column="2" Width="105" Height="142" CornerRadius="10" Margin="5"
                                                        Background="#20000000" ToolTipService.ToolTip="THE SONG OF SAYA">
                                                    <Image Source="ms-appx:///Assets/Games/saya.png" Stretch="UniformToFill" />
                                                </Border>
                                                <Border Grid.Row="1" Grid.Column="3" Width="105" Height="142" CornerRadius="10" Margin="5"
                                                        Background="#20000000" ToolTipService.ToolTip="ROBLOX">
                                                    <Image Source="ms-appx:///Assets/Games/roblox.png" Stretch="UniformToFill" />
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                    </Border>
                                </ScrollViewer>

                                <!-- CONTENU ONGLET 2 : ACTIVITY (Spotify / Rich Presence) -->
                                <ScrollViewer x:Name="ProfileActivityContent" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                                    <Border Background="#25000000" CornerRadius="16" Padding="16">
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="Activité actuelle" FontSize="15" FontWeight="Bold" Foreground="White" />
                                            <Border Background="#30000000" CornerRadius="12" Padding="16"
                                                    Visibility="{x:Bind FullProfileUser.HasRichPresence, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid Grid.Column="0" Width="68" Height="68" Margin="0,0,14,0">
                                                        <Border CornerRadius="10">
                                                            <Border.Background>
                                                                <ImageBrush ImageSource="{x:Bind FullProfileUser.PrimaryActivity.LargeImageUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                            </Border.Background>
                                                        </Border>
                                                    </Grid>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                                        <TextBlock Text="{x:Bind FullProfileUser.PrimaryActivity.HeaderLabel, Mode=OneWay}" FontSize="12" FontWeight="Bold" Opacity="0.75" Foreground="White" />
                                                        <TextBlock Text="{x:Bind FullProfileUser.PrimaryActivity.Name, Mode=OneWay}" FontSize="15" FontWeight="Bold" Foreground="White" />
                                                        <TextBlock Text="{x:Bind FullProfileUser.PrimaryActivity.Details, Mode=OneWay}" FontSize="13" Opacity="0.85" Foreground="White" />
                                                        <TextBlock Text="{x:Bind FullProfileUser.PrimaryActivity.State, Mode=OneWay}" FontSize="12" Opacity="0.7" Foreground="White" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </ScrollViewer>

                                <!-- CONTENU ONGLET 3 : WISHLIST -->
                                <ScrollViewer x:Name="ProfileWishlistContent" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                                    <Border Background="#25000000" CornerRadius="16" Padding="20">
                                        <StackPanel Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE734;" FontSize="28" Foreground="White" Opacity="0.5" HorizontalAlignment="Center" />
                                            <TextBlock Text="Aucun jeu dans la liste de souhaits pour le moment" FontSize="14" Opacity="0.65" Foreground="White" HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </ScrollViewer>

                                <!-- CONTENU ONGLET 4 : MUTUALS -->
                                <ScrollViewer x:Name="ProfileMutualsContent" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                                    <Border Background="#25000000" CornerRadius="16" Padding="16">
                                        <StackPanel Spacing="10">
                                            <TextBlock Text="Serveurs et amis en commun" FontSize="15" FontWeight="Bold" Foreground="White" />
                                            <TextBlock Text="{x:Bind FullProfileUser.MutualSummaryText, Mode=OneWay}" FontSize="13" Opacity="0.8" Foreground="White" />
                                        </StackPanel>
                                    </Border>
                                </ScrollViewer>
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Modal Éditeur de Profil (Fenêtre modale centrée non plein écran 100% fidèle à Discord) -->
        <Grid x:Name="ProfileEditorOverlay" Visibility="Collapsed" Background="#CC000000" Canvas.ZIndex="900"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
              PointerPressed="OnProfileEditorBackdropPointerPressed" />

        <!-- Overlay Zoom Plein Écran de l'Avatar (100% identique à media_1792268343564_b3db1471.png) -->
        <Grid x:Name="AvatarZoomOverlay" Visibility="Collapsed" Background="#E6000000" Canvas.ZIndex="999"
              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
              PointerPressed="OnAvatarZoomBackdropPointerPressed">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Image de profil agrandie avec coins légèrement arrondis comme dans Discord -->
                <Border CornerRadius="8" Background="#111214"
                        PointerPressed="OnAvatarZoomImagePointerPressed">
                    <Image x:Name="AvatarZoomImage" Stretch="Uniform"
                           MaxWidth="600" MaxHeight="600" />
                </Border>

                <!-- Bouton fermer (X) stylé en haut à droite -->
                <Button Width="36" Height="36" Padding="0" CornerRadius="18"
                        Background="#60000000" BorderThickness="0"
                        HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,-44,-8,0"
                        Click="OnCloseAvatarZoomClicked" ToolTipService.ToolTip="Fermer (Échap)">
                    <FontIcon Glyph="&#xE8BB;" FontSize="14" Foreground="White" />
                </Button>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
