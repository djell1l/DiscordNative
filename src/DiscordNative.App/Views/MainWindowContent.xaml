<UserControl
    x:Class="DiscordNative.App.Views.MainWindowContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:DiscordNative.Protocol.Models"
    xmlns:vm="using:DiscordNative.App.ViewModels"
    xmlns:controls="using:DiscordNative.App.Controls">

    <Grid x:Name="RootLayoutGrid">
        <controls:BackgroundImageHost x:Name="BackgroundHost" />

        <!-- Splash Screen animé au démarrage façon Discord -->
        <Grid x:Name="StartupSplash" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
              Canvas.ZIndex="1000" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="20">
                <Border x:Name="SplashLogoBorder" Width="96" Height="96" CornerRadius="28">
                    <Border.Background>
                        <ImageBrush ImageSource="ms-appx:///Assets/AppIcon.png" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
                <StackPanel Spacing="6" HorizontalAlignment="Center">
                    <TextBlock Text="Diswin" FontSize="26" FontWeight="Bold" HorizontalAlignment="Center" />
                    <TextBlock x:Name="SplashStatusText" Text="Vérification des mises à jour..." FontSize="13" Opacity="0.7" HorizontalAlignment="Center" />
                </StackPanel>
                <ProgressBar IsIndeterminate="True" Width="200" HorizontalAlignment="Center" CornerRadius="4" />
            </StackPanel>
        </Grid>

        <Grid Background="Transparent">
            <Grid.RowDefinitions>
                <RowDefinition Height="32" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" x:Name="AppTitleBar" Background="Transparent" />

            <!-- Bannière de notification et mise à jour automatique WinUI 3 InfoBar -->
            <InfoBar Grid.Row="1" x:Name="UpdateInfoBar"
                     IsOpen="False"
                     Severity="Informational"
                     Title="Mise à jour disponible"
                     Message="Une nouvelle version de Diswin est disponible."
                     CornerRadius="8"
                     Margin="12,0,12,8">
                <InfoBar.ActionButton>
                    <Button x:Name="ApplyUpdateButton" Content="Mettre à jour maintenant" Click="OnApplyUpdateClicked" Style="{StaticResource AccentButtonStyle}" />
                </InfoBar.ActionButton>
            </InfoBar>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="72" />
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- 0. Liste des serveurs -->
                <Grid Grid.Column="0" Background="Transparent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Spacing="0">
                        <!-- Bouton de mise à jour en haut à gauche façon Discord (affiché uniquement si une MàJ est disponible) -->
                        <Button x:Name="TopLeftUpdateButton"
                                Visibility="Collapsed"
                                Margin="12,12,12,0" Width="48" Height="48" CornerRadius="24" Padding="0"
                                Background="#23A55A" Foreground="White" BorderThickness="0"
                                Click="OnTopLeftUpdateClicked"
                                ToolTipService.ToolTip="Mise à jour disponible ! Cliquez pour mettre à jour et redémarrer">
                            <FontIcon Glyph="&#xE896;" FontSize="20" Foreground="White" />
                        </Button>

                        <Button Margin="12,12,12,4" Width="48" Height="48" CornerRadius="16" Padding="0"
                                Click="OnFriendsClicked" ToolTipService.ToolTip="Amis et messages privés">
                            <Grid Width="48" Height="48">
                                <Border Width="48" Height="48" CornerRadius="16">
                                    <Border.Background>
                                        <ImageBrush ImageSource="ms-appx:///Assets/AppIcon.png" Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                                <!-- Badge de notification DMs non lus en bas à droite -->
                                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                        Margin="0,0,-4,-4"
                                        Background="#DA373C"
                                        BorderBrush="#1E1F22" BorderThickness="3"
                                        CornerRadius="9" MinWidth="18" Height="18" Padding="4,0"
                                        Visibility="{x:Bind ViewModel.HasDmMentions, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{x:Bind ViewModel.DmMentionCountText, Mode=OneWay}"
                                               Foreground="White" FontSize="11" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Button>
                    </StackPanel>

                    <ListView Grid.Row="1" x:Name="GuildList"
                              ItemsSource="{x:Bind ViewModel.Guilds, Mode=OneWay}"
                              SelectionMode="Single"
                              SelectionChanged="OnGuildSelected"
                              Padding="0,4,0,0">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,8" />
                                <Setter Property="MinHeight" Value="48" />
                                <Setter Property="MinWidth" Value="72" />
                                <Setter Property="Width" Value="72" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="VerticalContentAlignment" Value="Center" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListViewItem">
                                            <ContentPresenter Content="{TemplateBinding Content}"
                                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                                              HorizontalAlignment="Stretch"
                                                              VerticalAlignment="Center"
                                                              Margin="0"
                                                              Padding="0" />
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:DiscordGuild">
                                <Grid Height="48" ToolTipService.ToolTip="{x:Bind Name}"
                                      PointerEntered="OnAvatarPointerEntered" PointerExited="OnAvatarPointerExited">
                                    <Grid.ContextFlyout>
                                        <MenuFlyout>
                                            <MenuFlyoutItem Text="Marquer comme lu" Click="OnMarkGuildReadClicked">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8FB;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Copier le nom" Click="OnCopyGuildNameClicked">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Copier l'identifiant" Click="OnCopyGuildIdClicked">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="Quitter le serveur" Click="OnLeaveGuildClicked" Foreground="#FF453A">
                                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE89B;" Foreground="#FF453A" /></MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Grid.ContextFlyout>

                                    <!-- Pilule blanche sur le bord gauche (Non lu = petit point 8px, Survol = 20px, Sélectionné = barre 40px) -->
                                    <Border HorizontalAlignment="Left" VerticalAlignment="Center"
                                            Width="8" Height="{x:Bind IndicatorHeight, Mode=OneWay}"
                                            Margin="-4,0,0,0"
                                            CornerRadius="0,4,4,0" Background="White"
                                            Visibility="{x:Bind HasUnreadOrSelected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                                    <!-- Conteneur d'icône du serveur centré 48x48 -->
                                    <Grid Width="48" Height="48" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Rectangle Fill="{ThemeResource ControlFillColorSecondaryBrush}" RadiusX="16" RadiusY="16" />
                                        <Rectangle RadiusX="16" RadiusY="16" Visibility="{x:Bind HasIcon, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <Rectangle.Fill>
                                                <ImageBrush ImageSource="{x:Bind IconUrl, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                            </Rectangle.Fill>
                                        </Rectangle>
                                        <TextBlock Text="{x:Bind Initials}" HorizontalAlignment="Center"
                                                   Visibility="{x:Bind ShowInitials, Converter={StaticResource BoolToVisibilityConverter}}"
                                                   VerticalAlignment="Center" FontWeight="SemiBold" FontSize="14" />

                                        <!-- Badge Vocal en haut à droite (haut-parleur sur fond noir) -->
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Margin="0,-3,-3,0"
                                                Background="#111214"
                                                BorderBrush="#1E1F22" BorderThickness="2"
                                                CornerRadius="9" Width="18" Height="18"
                                                Visibility="{x:Bind HasVoiceBadge, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                ToolTipService.ToolTip="Membres connectés en vocal">
                                            <FontIcon Glyph="&#xE767;" FontSize="9" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <!-- Badge Stream en haut à droite (écran sur fond noir si stream en cours) -->
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Top"
                                                Margin="0,-3,-3,0"
                                                Background="#111214"
                                                BorderBrush="#1E1F22" BorderThickness="2"
                                                CornerRadius="9" Width="18" Height="18"
                                                Visibility="{x:Bind HasStreamBadge, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                ToolTipService.ToolTip="Partage d'écran / Stream en cours">
                                            <FontIcon Glyph="&#xE7F4;" FontSize="9" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <!-- Badge Rouge de MENTION en bas à droite (exactement comme Discord officiel) -->
                                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                Margin="0,0,-4,-4"
                                                Background="#DA373C"
                                                BorderBrush="#1E1F22" BorderThickness="3"
                                                CornerRadius="9" MinWidth="18" Height="18" Padding="4,0"
                                                Visibility="{x:Bind HasMentions, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                ToolTipService.ToolTip="{x:Bind MentionTooltip, Mode=OneWay}">
                                            <TextBlock Text="{x:Bind MentionCountText, Mode=OneWay}"
                                                       Foreground="White" FontSize="11" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Bouton Rejoindre un serveur par invitation (+) -->
                    <Button Grid.Row="2" Margin="12,4,12,0" Width="48" Height="48" CornerRadius="16"
                            Click="OnJoinServerClicked" ToolTipService.ToolTip="Rejoindre un serveur (Invitation)">
                        <FontIcon Glyph="&#xE710;" />
                    </Button>

                    <Button Grid.Row="3" Margin="12" Width="48" Height="48" CornerRadius="16"
                            Click="OnSettingsClicked" ToolTipService.ToolTip="Paramètres">
                        <FontIcon Glyph="&#xE713;" />
                    </Button>
                </Grid>

                <!-- 1. Salons & DM -->
                <Grid Grid.Column="1" Background="Transparent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Haut gauche : Titre de serveur & Recherche de salons (Quick Switcher) -->
                    <StackPanel Grid.Row="0" Margin="12,10,12,10" Spacing="8">
                        <TextBlock Text="{x:Bind ViewModel.SelectedGuildName, Mode=OneWay}"
                                   FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" />
                        <TextBox x:Name="ChannelSearchBox"
                                 PlaceholderText="Rechercher un salon..."
                                 CornerRadius="8"
                                 FontSize="12"
                                 Height="32"
                                 Padding="10,4"
                                 BorderThickness="0"
                                 Background="{ThemeResource ControlFillColorDefaultBrush}"
                                 TextChanged="OnChannelSearchChanged"
                                 Visibility="{x:Bind ViewModel.ShowingGuildChannels, Mode=OneWay}" />
                    </StackPanel>

                    <Grid Grid.Row="1">
                        <ListView x:Name="ChannelList"
                                  ItemsSource="{x:Bind ViewModel.FilteredChannels, Mode=OneWay}"
                                  SelectionMode="Single"
                                  SelectionChanged="OnChannelSelected"
                                  Visibility="{x:Bind ViewModel.ShowingGuildChannels, Mode=OneWay}"
                                  Padding="8,0">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:DiscordChannel">
                                    <StackPanel Spacing="2" Padding="0,2">
                                        <StackPanel Orientation="Horizontal" Spacing="8" Padding="8,4">
                                            <StackPanel.ContextFlyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem Text="Créer une invitation" Click="OnCreateChannelInviteFromMenuClicked">
                                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72D;" /></MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutSeparator />
                                                    <MenuFlyoutItem Text="Copier le nom" Click="OnCopyChannelNameClicked">
                                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="Copier l'identifiant" Click="OnCopyChannelIdClicked">
                                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                </MenuFlyout>
                                            </StackPanel.ContextFlyout>
                                            <!-- Icône Salon Texte (#) ou Salon Vocal (Haut-parleur ou Cadenas si verrouillé) -->
                                            <Grid Width="16" Height="16" VerticalAlignment="Center">
                                                <!-- Cadenas si salon vocal verrouillé -->
                                                <FontIcon Glyph="&#xE72E;" FontSize="12" Foreground="#949BA4"
                                                          Visibility="{x:Bind IsLocked, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                          ToolTipService.ToolTip="Salon verrouillé" />
                                                <!-- Haut-parleur si salon vocal accessible -->
                                                <FontIcon Glyph="&#xE767;" FontSize="13"
                                                          Foreground="{x:Bind VoiceSpeakerColorBrush, Mode=OneWay}"
                                                          Visibility="{x:Bind ShowVoiceSpeakerIcon, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                <!-- Dièse si salon texte -->
                                                <TextBlock Text="#" FontSize="15" FontWeight="Bold" Foreground="#949BA4"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"
                                                           Visibility="{x:Bind IsVoiceChannel, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}" />
                                            </Grid>

                                            <TextBlock Text="{x:Bind DisplayName}" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13" />

                                            <!-- Badge du nombre d'utilisateurs connectés en vocal (ex: 02 / 99) -->
                                            <Border Background="#2B2D31" CornerRadius="8" Padding="6,1" VerticalAlignment="Center" Margin="6,0,0,0"
                                                    Visibility="{x:Bind HasConnectedVoiceMembers, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="{x:Bind VoiceLimitText, Mode=OneWay}" FontSize="10" Foreground="#DBDEE1" FontWeight="SemiBold" />
                                            </Border>

                                            <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                                    Margin="6,0,0,0"
                                                    Background="#DA373C"
                                                    CornerRadius="8" MinWidth="16" Height="16" Padding="4,0"
                                                    Visibility="{x:Bind HasMentions, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <TextBlock Text="{x:Bind MentionCountText, Mode=OneWay}"
                                                           Foreground="White" FontSize="10" FontWeight="Bold"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </StackPanel>

                                        <!-- Utilisateurs connectés dans ce salon vocal -->
                                        <ItemsControl ItemsSource="{x:Bind ConnectedVoiceMembers, Mode=OneWay}"
                                                      Visibility="{x:Bind HasConnectedVoiceMembers, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                      Margin="24,0,0,2">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="models:DiscordUser">
                                                    <StackPanel Orientation="Horizontal" Spacing="6" Padding="4,2">
                                                        <PersonPicture Width="18" Height="18"
                                                                       ProfilePicture="{x:Bind AvatarUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}"
                                                                       DisplayName="{x:Bind DisplayName, Mode=OneWay}" />
                                                        <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" FontSize="12" Opacity="0.85" VerticalAlignment="Center" />
                                                        <FontIcon Glyph="&#xE720;" FontSize="10" Foreground="#F23F43" VerticalAlignment="Center"
                                                                  Visibility="{x:Bind IsVoiceMuted, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                  ToolTipService.ToolTip="Muet" />
                                                        <FontIcon Glyph="&#xE7F6;" FontSize="10" Foreground="#F23F43" VerticalAlignment="Center"
                                                                  Visibility="{x:Bind IsVoiceDeafened, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                  ToolTipService.ToolTip="Sourdine" />
                                                        <Border Background="#F23F43" CornerRadius="3" Padding="4,1" VerticalAlignment="Center"
                                                                Visibility="{x:Bind IsStreaming, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <TextBlock Text="LIVE" FontSize="9" FontWeight="Bold" Foreground="White" />
                                                        </Border>

                                                        <!-- Icône du Jeu / Activité en cours comme sur Discord officiel -->
                                                        <Border Width="16" Height="16" CornerRadius="3" VerticalAlignment="Center"
                                                                Visibility="{x:Bind HasGameActivity, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                ToolTipService.ToolTip="{x:Bind GameTooltipText, Mode=OneWay}">
                                                            <Grid>
                                                                <!-- Image officielle du jeu (Hollow Knight, LoL, etc.) -->
                                                                <Image Source="{x:Bind CurrentGameIconUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}"
                                                                       Stretch="UniformToFill"
                                                                       Visibility="{x:Bind HasCurrentGameIcon, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                <!-- Icône Manette de jeu par défaut si l'image n'est pas fournie -->
                                                                <FontIcon Glyph="&#xE7FC;" FontSize="11" Foreground="#949BA4" VerticalAlignment="Center" HorizontalAlignment="Center"
                                                                          Visibility="{x:Bind HasCurrentGameIcon, Mode=OneWay, Converter={StaticResource InvertedBoolToVisibilityConverter}}" />
                                                            </Grid>
                                                        </Border>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <ScrollViewer Visibility="{x:Bind ViewModel.ShowingFriendsView, Mode=OneWay}">
                            <StackPanel>
                                <TextBlock Text="Messages privés" Margin="12,8,12,4" Opacity="0.6" FontSize="12" FontWeight="SemiBold" />
                                <ListView x:Name="PrivateChannelList"
                                          ItemsSource="{x:Bind ViewModel.PrivateChannels, Mode=OneWay}"
                                          SelectionMode="Single"
                                          SelectionChanged="OnChannelSelected"
                                          Padding="8,0">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:DiscordChannel">
                                            <StackPanel Orientation="Horizontal" Spacing="8" Padding="8,6">
                                                <StackPanel.ContextFlyout>
                                                    <MenuFlyout>
                                                        <MenuFlyoutItem Text="Ouvrir le salon" Click="OnOpenDmChannelClicked">
                                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8BD;" /></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Text="Copier le nom" Click="OnCopyChannelNameClicked">
                                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Text="Copier l'identifiant" Click="OnCopyChannelIdClicked">
                                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                    </MenuFlyout>
                                                </StackPanel.ContextFlyout>
                                                <Grid Width="28" Height="28" PointerEntered="OnAvatarPointerEntered" PointerExited="OnAvatarPointerExited">
                                                    <Ellipse Fill="{ThemeResource ControlFillColorSecondaryBrush}" />
                                                    <Ellipse>
                                                        <Ellipse.Fill>
                                                            <ImageBrush ImageSource="{x:Bind IconUrl, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                        </Ellipse.Fill>
                                                    </Ellipse>
                                                </Grid>
                                                <TextBlock Text="{x:Bind DisplayName}" VerticalAlignment="Center" />
                                                <Border HorizontalAlignment="Right" VerticalAlignment="Center"
                                                        Margin="8,0,0,0"
                                                        Background="#DA373C"
                                                        CornerRadius="8" MinWidth="16" Height="16" Padding="4,0"
                                                        Visibility="{x:Bind HasMentions, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <TextBlock Text="{x:Bind MentionCountText, Mode=OneWay}"
                                                               Foreground="White" FontSize="10" FontWeight="Bold"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <!-- Section Amis avec filtres et Ajout d'ami façon SakuraCord -->
                                <Grid Margin="12,16,12,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Amis" Opacity="0.6" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="+ Ajouter" FontSize="11" Padding="8,3" CornerRadius="6"
                                            Style="{StaticResource AccentButtonStyle}" Click="OnAddFriendClicked" />
                                </Grid>

                                <StackPanel Orientation="Horizontal" Spacing="4" Margin="12,0,12,6">
                                    <Button Content="Tous" FontSize="11" Padding="8,3" CornerRadius="6" Click="OnFilterAllFriendsClicked" />
                                    <Button Content="En attente" FontSize="11" Padding="8,3" CornerRadius="6" Click="OnFilterPendingFriendsClicked" />
                                    <Button Content="Bloqués" FontSize="11" Padding="8,3" CornerRadius="6" Click="OnFilterBlockedFriendsClicked" />
                                </StackPanel>

                                <ListView x:Name="FriendList"
                                          ItemsSource="{x:Bind ViewModel.FilteredFriends, Mode=OneWay}"
                                          SelectionMode="None"
                                          Padding="8,0">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:DiscordRelationship">
                                            <StackPanel Orientation="Horizontal" Spacing="8" Padding="8,6">
                                                <StackPanel.ContextFlyout>
                                                    <MenuFlyout>
                                                        <MenuFlyoutItem Text="Envoyer un message privé" Click="OnFriendProfileClicked">
                                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8BD;" /></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Text="Accepter la demande" Click="OnAcceptFriendClicked"
                                                                        Visibility="{x:Bind IsPendingIncoming, Converter={StaticResource BoolToVisibilityConverter}}">
                                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8FB;" /></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutSeparator />
                                                        <MenuFlyoutItem Text="Copier le pseudo" Click="OnCopyFriendUsernameClicked">
                                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Text="Copier l'identifiant" Click="OnCopyFriendIdClicked">
                                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutSeparator />
                                                        <MenuFlyoutItem Text="Bloquer l'utilisateur" Click="OnBlockFriendClicked">
                                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8F8;" /></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Text="Retirer / Refuser" Click="OnRemoveFriendClicked" Foreground="#FF453A">
                                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" Foreground="#FF453A" /></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                    </MenuFlyout>
                                                </StackPanel.ContextFlyout>
                                                <Grid Width="30" Height="30" PointerEntered="OnAvatarPointerEntered" PointerExited="OnAvatarPointerExited">
                                                    <Ellipse Fill="{ThemeResource ControlFillColorSecondaryBrush}" />
                                                    <Ellipse>
                                                        <Ellipse.Fill>
                                                            <ImageBrush ImageSource="{x:Bind User.AvatarUrl, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                        </Ellipse.Fill>
                                                    </Ellipse>
                                                    <Ellipse Width="10" Height="10" Fill="{x:Bind User.StatusColor, Mode=OneWay}"
                                                             Stroke="{ThemeResource ApplicationPageBackgroundThemeBrush}" StrokeThickness="2"
                                                             HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                                </Grid>
                                                <StackPanel VerticalAlignment="Center" MaxWidth="165">
                                                    <TextBlock Text="{x:Bind User.DisplayName}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind SubtitleText, Mode=OneWay}" FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- Bas gauche : Panneau Vocal & Profil -->
                    <StackPanel Grid.Row="2" Background="Transparent">
                        <!-- Statut de connexion vocal actif + Partage d'écran / Caméra / Krisp -->
                        <StackPanel Padding="10,8" Background="#1B7A43" CornerRadius="12" Margin="8,0,8,6" Spacing="6"
                                    Visibility="{x:Bind ViewModel.IsVoiceConnected, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE803;" FontSize="17" Foreground="White" VerticalAlignment="Center" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Voix connectée" FontWeight="Bold" FontSize="12" Foreground="White" />
                                        <TextBlock Text="{x:Bind ViewModel.ConnectedVoiceChannelName, Mode=OneWay}" FontSize="11" Foreground="White" Opacity="0.85" TextTrimming="CharacterEllipsis" MaxWidth="135" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <!-- Bouton Suppression de bruit Krisp (100% Gratuit) -->
                                    <Button Height="26" CornerRadius="13" Padding="7,0" Background="#33FFFFFF" BorderThickness="0"
                                            Click="OnToggleKrispClicked"
                                            Opacity="{x:Bind ViewModel.KrispOpacity, Mode=OneWay}"
                                            ToolTipService.ToolTip="{x:Bind ViewModel.KrispTooltipText, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE9F5;" FontSize="11" Foreground="White" />
                                            <TextBlock Text="Krisp" FontSize="10" FontWeight="Bold" Foreground="White" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Width="26" Height="26" CornerRadius="13" Padding="0" Background="#33FFFFFF" BorderThickness="0" Click="OnDisconnectVoiceClicked" ToolTipService.ToolTip="Se déconnecter">
                                        <FontIcon Glyph="&#xE711;" FontSize="11" Foreground="White" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!-- Boutons Caméra & Partager l'écran (Go Live) comme sur Discord -->
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" HorizontalAlignment="Stretch" Height="30" CornerRadius="8" Padding="6,0"
                                        Background="#26FFFFFF" BorderThickness="0"
                                        Click="OnToggleCameraClicked"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.CameraTooltipText, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE714;" FontSize="12" Foreground="{x:Bind ViewModel.CameraIconBrush, Mode=OneWay}" />
                                        <TextBlock Text="Vidéo" FontSize="11" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="1" HorizontalAlignment="Stretch" Height="30" CornerRadius="8" Padding="6,0"
                                        Background="#26FFFFFF" BorderThickness="0"
                                        Click="OnScreenShareClicked"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.ScreenShareTooltipText, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE7F4;" FontSize="12" Foreground="{x:Bind ViewModel.ScreenShareIconBrush, Mode=OneWay}" />
                                        <TextBlock Text="Écran" FontSize="11" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- Barre Profil Utilisateur & Contrôles Audio Mute/Deafen/Settings -->
                        <Grid Height="56" Padding="8,4" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" Margin="8,0,8,8" CornerRadius="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!-- Profil & Statut Sélecteur avec Popout Discord complet -->
                            <Button Grid.Column="0" Background="Transparent" BorderThickness="0" Padding="4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" CornerRadius="8">
                                <Button.Flyout>
                                    <Flyout Placement="TopEdgeAlignedLeft">
                                        <Flyout.FlyoutPresenterStyle>
                                            <Style TargetType="FlyoutPresenter">
                                                <Setter Property="Padding" Value="0" />
                                                <Setter Property="CornerRadius" Value="16" />
                                                <Setter Property="MaxWidth" Value="340" />
                                            </Style>
                                        </Flyout.FlyoutPresenterStyle>
                                        <Grid Width="320" Background="{ThemeResource LayerFillColorDefaultBrush}">
                                            <!-- Bannière utilisateur (120px de haut, calée en haut, coins arrondis clippés) -->
                                            <Border Height="120" VerticalAlignment="Top" Background="#5865F2" CornerRadius="16,16,0,0">
                                                <Border CornerRadius="16,16,0,0"
                                                        Visibility="{x:Bind ViewModel.CurrentUserHasBanner, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                    <Border.Background>
                                                        <ImageBrush ImageSource="{x:Bind ViewModel.CurrentUserBannerUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}"
                                                                    Stretch="UniformToFill" AlignmentY="Center" AlignmentX="Center" />
                                                    </Border.Background>
                                                </Border>
                                            </Border>

                                            <!-- Avatar rond qui chevauche la bannière (cliquable pour ouvrir la vue complète) -->
                                            <Button Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="40"
                                                    Margin="16,76,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                    ToolTipService.ToolTip="Afficher le profil complet"
                                                    Tag="{x:Bind ViewModel.CurrentUser, Mode=OneWay}"
                                                    Click="OnOpenFullUserProfileFromPopoutClicked">
                                                <Ellipse Width="80" Height="80"
                                                         StrokeThickness="5" Stroke="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                                                    <Ellipse.Fill>
                                                        <ImageBrush ImageSource="{x:Bind ViewModel.CurrentUserAvatarUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                            </Button>

                                            <!-- Pastille d'état sur l'avatar -->
                                            <Ellipse Width="18" Height="18" Margin="74,136,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                     Fill="{x:Bind ViewModel.StatusDotBrush, Mode=OneWay}"
                                                     Stroke="{ThemeResource ApplicationPageBackgroundThemeBrush}" StrokeThickness="3" />

                                            <!-- Contenu du profil positionné proprement sous la bannière -->
                                            <StackPanel Margin="16,164,16,16" Spacing="8">
                                                <TextBlock Text="{x:Bind ViewModel.CurrentUserName, Mode=OneWay}" FontWeight="Bold" FontSize="18" TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind ViewModel.CurrentUserTag, Mode=OneWay}" Opacity="0.6" FontSize="12" VerticalAlignment="Center" />
                                                    <TextBlock Text="•" Opacity="0.4" FontSize="12" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.CurrentUserPronounsVisibility, Mode=OneWay}" />
                                                    <TextBlock Text="{x:Bind ViewModel.CurrentUserPronouns, Mode=OneWay}" Opacity="0.7" FontSize="12" VerticalAlignment="Center" Visibility="{x:Bind ViewModel.CurrentUserPronounsVisibility, Mode=OneWay}" />

                                                    <!-- Tag de Clan / Serveur Principal (ex: 🌸 DSKY) -->
                                                    <Border Visibility="{x:Bind ViewModel.CurrentUserClanVisibility, Mode=OneWay}"
                                                            Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                            BorderThickness="1" CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                            <Image Width="14" Height="14" Source="{x:Bind ViewModel.CurrentUserClanBadgeUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" Stretch="Uniform" />
                                                            <TextBlock Text="{x:Bind ViewModel.CurrentUserClanTag, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>

                                                <!-- Badges officiels du profil Discord -->
                                                <ItemsControl ItemsSource="{x:Bind ViewModel.CurrentUserBadges, Mode=OneWay}"
                                                              Visibility="{x:Bind ViewModel.CurrentUserBadgesVisibility, Mode=OneWay}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" Spacing="6" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="models:DiscordBadge">
                                                            <Image Width="20" Height="20"
                                                                   Source="{x:Bind IconUrl, Converter={StaticResource StringToImageSourceConverter}}"
                                                                   ToolTipService.ToolTip="{x:Bind Description}"
                                                                   Stretch="Uniform" />
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- Bio / À propos de moi -->
                                                <Border BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="2,0,0,0" Padding="8,0,0,0" Margin="0,2,0,0">
                                                    <TextBlock Text="{x:Bind ViewModel.CurrentUserBio, Mode=OneWay}" FontSize="12" FontStyle="Italic" TextWrapping="Wrap" Opacity="0.85" />
                                                </Border>

                                                <!-- Carte Rich Presence (RPC) Actif sur notre propre profil -->
                                                <Border Visibility="{x:Bind ViewModel.CurrentUserRichPresenceVisibility, Mode=OneWay}"
                                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1" CornerRadius="10" Padding="10">
                                                    <StackPanel Spacing="6">
                                                        <TextBlock Text="{x:Bind ViewModel.CurrentUserRpcHeader, Mode=OneWay}" FontSize="10" FontWeight="Bold" Opacity="0.65" />
                                                        <Grid ColumnSpacing="10">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Grid Grid.Column="0" Width="56" Height="56" VerticalAlignment="Top"
                                                                  Visibility="{x:Bind ViewModel.CurrentUserRpcLargeImageVisibility, Mode=OneWay}">
                                                                <Border Width="56" Height="56" CornerRadius="8">
                                                                    <Border.Background>
                                                                        <ImageBrush ImageSource="{x:Bind ViewModel.CurrentUserRpcLargeImageUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                                    </Border.Background>
                                                                </Border>
                                                                <Ellipse Width="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-3,-3"
                                                                         Stroke="{ThemeResource CardBackgroundFillColorDefaultBrush}" StrokeThickness="2"
                                                                         Visibility="{x:Bind ViewModel.CurrentUserRpcSmallImageVisibility, Mode=OneWay}">
                                                                    <Ellipse.Fill>
                                                                        <ImageBrush ImageSource="{x:Bind ViewModel.CurrentUserRpcSmallImageUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                                    </Ellipse.Fill>
                                                                </Ellipse>
                                                            </Grid>
                                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                                <TextBlock Text="{x:Bind ViewModel.CurrentUserRpcName, Mode=OneWay}" FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{x:Bind ViewModel.CurrentUserRpcDetails, Mode=OneWay}" FontSize="11" Opacity="0.85" TextTrimming="CharacterEllipsis"
                                                                           Visibility="{x:Bind ViewModel.CurrentUserRpcDetailsVisibility, Mode=OneWay}" />
                                                                <TextBlock Text="{x:Bind ViewModel.CurrentUserRpcState, Mode=OneWay}" FontSize="11" Opacity="0.75" TextTrimming="CharacterEllipsis"
                                                                           Visibility="{x:Bind ViewModel.CurrentUserRpcStateVisibility, Mode=OneWay}" />
                                                                <TextBlock Text="{x:Bind ViewModel.CurrentUserRpcElapsed, Mode=OneWay}" FontSize="11" Foreground="#23A55A" FontWeight="SemiBold"
                                                                           Visibility="{x:Bind ViewModel.CurrentUserRpcElapsedVisibility, Mode=OneWay}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Widget : Game Collection (comme sur Discord) -->
                                                <Border Visibility="{x:Bind ViewModel.CurrentUserGameWidgetsVisibility, Mode=OneWay}"
                                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1" CornerRadius="10" Padding="10,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Text="Game Collection" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        <ItemsControl Grid.Column="1" ItemsSource="{x:Bind ViewModel.CurrentUserGameWidgets, Mode=OneWay}" VerticalAlignment="Center">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate x:DataType="models:DiscordWidgetGame">
                                                                    <Border Width="28" Height="28" CornerRadius="6" ToolTipService.ToolTip="{x:Bind TooltipText}">
                                                                        <Border.Background>
                                                                            <ImageBrush ImageSource="{x:Bind IconUrl, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                                        </Border.Background>
                                                                    </Border>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Grid>
                                                </Border>

                                                <!-- Comptes reliés et liens affichés sur le profil (ex: GitHub, Steam, jay-space.com...) -->
                                                <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.CurrentUserConnectedAccountsVisibility, Mode=OneWay}">
                                                    <TextBlock Text="COMPTES ET LIENS RELIÉS" FontSize="10" FontWeight="Bold" Opacity="0.65" />
                                                    <ItemsControl ItemsSource="{x:Bind ViewModel.CurrentUserConnectedAccounts, Mode=OneWay}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Spacing="4" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="models:DiscordConnectedAccount">
                                                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                        BorderThickness="1" CornerRadius="8" Padding="10,7"
                                                                        Tag="{x:Bind}"
                                                                        Click="OnConnectedAccountClicked"
                                                                        ToolTipService.ToolTip="{x:Bind TooltipText}">
                                                                    <Grid ColumnSpacing="8">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <Border Grid.Column="0" Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                                                CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                                                                            <TextBlock Text="{x:Bind PlatformBadgeText}" FontSize="11" FontWeight="Bold" />
                                                                        </Border>
                                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                                <TextBlock Text="{x:Bind Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="165" />
                                                                                <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="#23A55A" VerticalAlignment="Center"
                                                                                          Visibility="{x:Bind Verified, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                                          ToolTipService.ToolTip="Compte vérifié" />
                                                                            </StackPanel>
                                                                            <TextBlock Text="{x:Bind PlatformDisplayName}" FontSize="10" Opacity="0.6" />
                                                                        </StackPanel>
                                                                        <FontIcon Grid.Column="2" Glyph="&#xE8A7;" FontSize="12" Opacity="0.65" VerticalAlignment="Center"
                                                                                  Visibility="{x:Bind HasUrl, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                    </Grid>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>

                                                <MenuFlyoutSeparator Margin="0,2" />

                                                <!-- Menu d'actions style Discord (Modifier le profil + Rich Presence + Menu déroulant de statut + Copier l'ID) -->
                                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1" CornerRadius="10" Padding="4">
                                                    <StackPanel Spacing="2">
                                                        <!-- Modifier le profil -->
                                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                                Background="Transparent" BorderThickness="0" Padding="10,8" CornerRadius="6"
                                                                Click="OnEditProfileClicked">
                                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                                <FontIcon Glyph="&#xE70F;" FontSize="14" Opacity="0.85" />
                                                                 <TextBlock Text="Modifier le profil" FontSize="13" FontWeight="Medium" />
                                                            </StackPanel>
                                                        </Button>

                                                        <!-- Sélecteur de statut avec sous-menu déroulant latéral comme sur Discord -->
                                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                                Background="Transparent" BorderThickness="0" Padding="10,8" CornerRadius="6">
                                                            <Button.Flyout>
                                                                <Flyout Placement="RightEdgeAlignedTop">
                                                                    <StackPanel Width="240" Spacing="2">
                                                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                                                Background="Transparent" BorderThickness="0" Padding="10,8" CornerRadius="6"
                                                                                Click="OnStatusOnlineClicked">
                                                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                                                <Ellipse Width="10" Height="10" Fill="#23A55A" VerticalAlignment="Center" />
                                                                                <TextBlock Text="En ligne" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                            </StackPanel>
                                                                        </Button>
                                                                        <MenuFlyoutSeparator Margin="4,2" />
                                                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                                                Background="Transparent" BorderThickness="0" Padding="10,8" CornerRadius="6"
                                                                                Click="OnStatusIdleClicked">
                                                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                                                <Ellipse Width="10" Height="10" Fill="#F0B232" VerticalAlignment="Center" />
                                                                                <TextBlock Text="Inactif" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                            </StackPanel>
                                                                        </Button>
                                                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                                                Background="Transparent" BorderThickness="0" Padding="10,8" CornerRadius="6"
                                                                                Click="OnStatusDndClicked">
                                                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                                                <Ellipse Width="10" Height="10" Fill="#F23F43" VerticalAlignment="Top" Margin="0,4,0,0" />
                                                                                <StackPanel Spacing="2">
                                                                                    <TextBlock Text="Ne pas déranger" FontSize="13" FontWeight="SemiBold" />
                                                                                    <TextBlock Text="Vous ne recevrez aucune notification de bureau" FontSize="11" Opacity="0.6" TextWrapping="Wrap" Width="185" />
                                                                                </StackPanel>
                                                                            </StackPanel>
                                                                        </Button>
                                                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                                                Background="Transparent" BorderThickness="0" Padding="10,8" CornerRadius="6"
                                                                                Click="OnStatusInvisibleClicked">
                                                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                                                <Ellipse Width="10" Height="10" Stroke="#80848E" StrokeThickness="2.5" Fill="Transparent" VerticalAlignment="Top" Margin="0,4,0,0" />
                                                                                <StackPanel Spacing="2">
                                                                                    <TextBlock Text="Invisible" FontSize="13" FontWeight="SemiBold" />
                                                                                    <TextBlock Text="Vous apparaîtrez hors ligne" FontSize="11" Opacity="0.6" TextWrapping="Wrap" Width="185" />
                                                                                </StackPanel>
                                                                            </StackPanel>
                                                                        </Button>
                                                                    </StackPanel>
                                                                </Flyout>
                                                            </Button.Flyout>
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <Ellipse Grid.Column="0" Width="10" Height="10" Fill="{x:Bind ViewModel.StatusDotBrush, Mode=OneWay}" VerticalAlignment="Center" Margin="2,0,10,0" />
                                                                <TextBlock Grid.Column="1" Text="{x:Bind ViewModel.CurrentStatusDisplayName, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
                                                            </Grid>
                                                        </Button>

                                                        <MenuFlyoutSeparator Margin="4,2" />

                                                        <!-- Copier l'identifiant utilisateur -->
                                                        <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                                Background="Transparent" BorderThickness="0" Padding="10,8" CornerRadius="6"
                                                                Click="OnCopyCurrentUserIdClicked">
                                                            <StackPanel Orientation="Horizontal" Spacing="10">
                                                                <FontIcon Glyph="&#xE8C8;" FontSize="14" Opacity="0.85" />
                                                                <TextBlock Text="Copier l'identifiant" FontSize="13" />
                                                            </StackPanel>
                                                        </Button>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                    </Flyout>
                                </Button.Flyout>
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Grid Width="34" Height="34" PointerEntered="OnAvatarPointerEntered" PointerExited="OnAvatarPointerExited"
                                          DoubleTapped="OnCurrentUserAvatarDoubleTapped" ToolTipService.ToolTip="Double-cliquez pour afficher votre profil complet">
                                        <Ellipse Fill="{ThemeResource ControlFillColorSecondaryBrush}" />
                                        <Ellipse>
                                            <Ellipse.Fill>
                                                <ImageBrush ImageSource="{x:Bind ViewModel.CurrentUserAvatarUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <!-- Cercle vert quand notre micro détecte le son en appel vocal -->
                                        <Ellipse Width="34" Height="34" Stroke="#23A55A" StrokeThickness="2.5" Fill="Transparent"
                                                 Opacity="{x:Bind ViewModel.CurrentUserSpeakingRingOpacity, Mode=OneWay}"
                                                 IsHitTestVisible="False" />
                                        <Ellipse Width="10" Height="10" Fill="{x:Bind ViewModel.StatusDotBrush, Mode=OneWay}"
                                                 Stroke="{ThemeResource ApplicationPageBackgroundThemeBrush}" StrokeThickness="2"
                                                 HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                                    </Grid>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind ViewModel.CurrentUserName, Mode=OneWay}"
                                                   FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" MaxWidth="105" />
                                        <TextBlock Text="{x:Bind ViewModel.CurrentUserSubStatusText, Mode=OneWay}"
                                                   FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis" MaxWidth="115" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>

                            <!-- Boutons Audio Krisp / Mute / Deafen -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                                <Button Width="32" Height="32" CornerRadius="16" Padding="0" Background="Transparent" BorderThickness="0"
                                        Click="OnToggleKrispClicked" ToolTipService.ToolTip="{x:Bind ViewModel.KrispTooltipText, Mode=OneWay}">
                                    <FontIcon Glyph="&#xE9F5;" FontSize="14" Foreground="{x:Bind ViewModel.KrispIconBrush, Mode=OneWay}" Opacity="{x:Bind ViewModel.KrispOpacity, Mode=OneWay}" />
                                </Button>
                                <Button Width="32" Height="32" CornerRadius="16" Padding="0" Background="Transparent" BorderThickness="0"
                                        Click="OnToggleMuteClicked" ToolTipService.ToolTip="Couper/Activer le micro">
                                    <FontIcon Glyph="&#xE720;" FontSize="14" Opacity="{x:Bind ViewModel.MuteOpacity, Mode=OneWay}" />
                                </Button>
                                <Button Width="32" Height="32" CornerRadius="16" Padding="0" Background="Transparent" BorderThickness="0"
                                        Click="OnToggleDeafenClicked" ToolTipService.ToolTip="Mettre en sourdine">
                                    <FontIcon Glyph="&#xE7F6;" FontSize="14" Opacity="{x:Bind ViewModel.DeafenOpacity, Mode=OneWay}" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>

                <!-- 2. Zone principale : En-tête + Chat/Vocal + Liste des membres -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="48" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- En-tête de salon avec Actions (Inviter, Épinglés, Mentions, Membres) -->
                    <Border Grid.Row="0" Grid.ColumnSpan="2" Background="Transparent"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                        <Grid Margin="16,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <FontIcon Glyph="&#xE803;" FontSize="16" Opacity="0.6" Visibility="{x:Bind ViewModel.VoiceViewVisibility, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind ViewModel.SelectedChannelName, Mode=OneWay}"
                                           FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Text="|" Opacity="0.3" VerticalAlignment="Center"
                                           Visibility="{x:Bind ViewModel.TopicVisibility, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind ViewModel.SelectedChannelTopic, Mode=OneWay}"
                                           FontSize="12" Opacity="0.6" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" MaxWidth="360"
                                           Visibility="{x:Bind ViewModel.TopicVisibility, Mode=OneWay}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <!-- Démarrer / Rejoindre un appel vocal -->
                                <Button Width="34" Height="34" Padding="0" CornerRadius="8" Background="Transparent" BorderThickness="0"
                                        Click="OnStartCallClicked" ToolTipService.ToolTip="Démarrer ou rejoindre l'appel vocal">
                                    <FontIcon Glyph="&#xE717;" FontSize="15" />
                                </Button>

                                <!-- Créer une invitation -->
                                <Button Width="34" Height="34" Padding="0" CornerRadius="8" Background="Transparent" BorderThickness="0"
                                        Click="OnCreateChannelInviteClicked" ToolTipService.ToolTip="Créer un lien d'invitation">
                                    <FontIcon Glyph="&#xE72D;" FontSize="15" />
                                </Button>

                                <!-- Messages Épinglés -->
                                <Button Width="34" Height="34" Padding="0" CornerRadius="8" Background="Transparent" BorderThickness="0"
                                        Click="OnOpenPinsFlyoutClicked" ToolTipService.ToolTip="Messages épinglés">
                                    <FontIcon Glyph="&#xE718;" FontSize="15" />
                                    <Button.Flyout>
                                        <Flyout Placement="BottomEdgeAlignedRight">
                                            <StackPanel Width="360" Spacing="10">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE718;" FontSize="15" VerticalAlignment="Center" />
                                                    <TextBlock Text="Messages épinglés" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <ScrollViewer MaxHeight="380">
                                                    <ItemsControl ItemsSource="{x:Bind ViewModel.PinnedMessages, Mode=OneWay}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="models:DiscordMessage">
                                                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                        BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                                                    <StackPanel Spacing="4">
                                                                        <Grid>
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="*" />
                                                                                <ColumnDefinition Width="Auto" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                <TextBlock Text="{x:Bind Author.DisplayName}" FontWeight="SemiBold" FontSize="13" />
                                                                                <TextBlock Text="{x:Bind TimeText}" FontSize="11" Opacity="0.5" VerticalAlignment="Center" />
                                                                            </StackPanel>
                                                                            <Button Grid.Column="1" Content="Désépingler" FontSize="10" Padding="6,2"
                                                                                    Click="OnUnpinFromFlyoutClicked" />
                                                                        </Grid>
                                                                        <TextBlock Text="{x:Bind Content}" TextWrapping="Wrap" FontSize="13" Opacity="0.9" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>

                                <!-- Boîte de réception / Mentions (@) -->
                                <Button Width="34" Height="34" Padding="0" CornerRadius="8" Background="Transparent" BorderThickness="0"
                                        Click="OnOpenMentionsFlyoutClicked" ToolTipService.ToolTip="Mentions récentes (@)">
                                    <FontIcon Glyph="&#xE715;" FontSize="15" />
                                    <Button.Flyout>
                                        <Flyout Placement="BottomEdgeAlignedRight">
                                            <StackPanel Width="360" Spacing="10">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE715;" FontSize="15" VerticalAlignment="Center" />
                                                    <TextBlock Text="Mentions récentes" FontWeight="Bold" FontSize="15" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <ScrollViewer MaxHeight="380">
                                                    <ItemsControl ItemsSource="{x:Bind ViewModel.RecentMentions, Mode=OneWay}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="models:DiscordMessage">
                                                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                                        BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,8">
                                                                    <StackPanel Spacing="4">
                                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                                            <TextBlock Text="{x:Bind Author.DisplayName}" FontWeight="SemiBold" FontSize="13" />
                                                                            <TextBlock Text="{x:Bind TimeText}" FontSize="11" Opacity="0.5" VerticalAlignment="Center" />
                                                                        </StackPanel>
                                                                        <TextBlock Text="{x:Bind Content}" TextWrapping="Wrap" FontSize="13" Opacity="0.9" />
                                                                    </StackPanel>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </ScrollViewer>
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>

                                <!-- Afficher / Masquer la liste des membres -->
                                <Button Width="34" Height="34" Padding="0" CornerRadius="8" Background="Transparent" BorderThickness="0"
                                        Click="OnToggleMemberListClicked" ToolTipService.ToolTip="Afficher / Masquer les participants">
                                    <FontIcon Glyph="&#xE716;" FontSize="15" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- VUE VOCALE (Scène de partage d'écran Go Live + Grille de participants avec encadrement vert + Barre de contrôle complète) -->
                    <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Visibility="{x:Bind ViewModel.VoiceViewVisibility, Mode=OneWay}" Padding="20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Scène de Partage d'Écran en Direct (Go Live Stage) -->
                        <Border Grid.Row="0" Height="340" Margin="10,0,10,14" CornerRadius="16"
                                Background="#111214" BorderBrush="#23A55A" BorderThickness="2"
                                Visibility="{x:Bind ViewModel.ScreenShareStageVisibility, Mode=OneWay}">
                            <Grid>
                                <Image x:Name="LiveScreenShareImage" Stretch="Uniform" />

                                <!-- Bandeau supérieur : EN DIRECT + Résolution/FPS + Titre de la source -->
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,12">
                                    <Border Background="#DA373C" CornerRadius="6" Padding="8,3">
                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                            <Ellipse Width="7" Height="7" Fill="White" VerticalAlignment="Center" />
                                            <TextBlock Text="EN DIRECT" Foreground="White" FontWeight="Bold" FontSize="11" />
                                        </StackPanel>
                                    </Border>
                                    <Border Background="#99000000" CornerRadius="6" Padding="8,3">
                                        <TextBlock Text="{x:Bind ViewModel.ScreenShareQualityBadge, Mode=OneWay}" Foreground="White" FontWeight="SemiBold" FontSize="11" />
                                    </Border>
                                    <Border Background="#99000000" CornerRadius="6" Padding="10,3">
                                        <TextBlock Text="{x:Bind ViewModel.ScreenShareTitle, Mode=OneWay}" Foreground="White" FontWeight="SemiBold" FontSize="11" MaxWidth="360" TextTrimming="CharacterEllipsis" />
                                    </Border>
                                </StackPanel>

                                <!-- Boutons rapides sur le stream : Changer de fenêtre / Arrêter le stream -->
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="14,12">
                                    <Button Content="Changer de source" FontSize="11" Padding="10,5" CornerRadius="8"
                                            Background="#AA000000" Foreground="White" BorderThickness="0"
                                            Click="OnChangeScreenShareSourceClicked" />
                                    <Button Content="Arrêter le stream" FontSize="11" Padding="10,5" CornerRadius="8"
                                            Background="#DA373C" Foreground="White" BorderThickness="0"
                                            Click="OnStopScreenShareClicked" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <GridView Grid.Row="1" ItemsSource="{x:Bind ViewModel.VoiceParticipants, Mode=OneWay}" SelectionMode="None" Margin="0,0,0,76">
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="models:DiscordUser">
                                    <Grid Width="260" Height="190" Margin="10">
                                        <!-- Carte de fond -->
                                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                                CornerRadius="16">
                                            <Grid>
                                                <!-- Avatar du participant -->
                                                <Ellipse Width="88" Height="88" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <Ellipse.Fill>
                                                        <ImageBrush ImageSource="{x:Bind AvatarUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                    </Ellipse.Fill>
                                                </Ellipse>

                                                <!-- Cercle vert autour de l'avatar quand le micro détecte la voix -->
                                                <Ellipse Width="96" Height="96" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                         Stroke="#23A55A" StrokeThickness="3.5" Fill="Transparent"
                                                         Opacity="{x:Bind SpeakingRingOpacity, Mode=OneWay}"
                                                         IsHitTestVisible="False" />

                                                <!-- Badge rouge EN DIRECT en haut à droite si le participant partage son écran -->
                                                <Border Background="#DA373C" CornerRadius="6" Padding="7,2"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top" Margin="12"
                                                        Opacity="{x:Bind StreamingBadgeOpacity, Mode=OneWay}">
                                                    <TextBlock Text="EN DIRECT" Foreground="White" FontWeight="Bold" FontSize="10" />
                                                </Border>

                                                <!-- Nom du participant en bas à gauche de la carte -->
                                                <Border Background="#66000000" CornerRadius="8" Padding="8,4"
                                                        HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="12">
                                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <Ellipse Width="8" Height="8" Fill="#23A55A" VerticalAlignment="Center"
                                                                 Opacity="{x:Bind SpeakingRingOpacity, Mode=OneWay}" />
                                                        <TextBlock Text="{x:Bind DisplayName, Mode=OneWay}" Foreground="White" FontWeight="SemiBold" FontSize="12" MaxWidth="145" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Border>

                                                <!-- Indicateurs Caméra / Micro coupé / Casque coupé en bas à droite de la carte -->
                                                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="12">
                                                    <Border Background="#99000000" CornerRadius="6" Padding="5,4"
                                                            Opacity="{x:Bind VideoBadgeOpacity, Mode=OneWay}">
                                                        <FontIcon Glyph="&#xE714;" FontSize="11" Foreground="#23A55A" />
                                                    </Border>
                                                    <Border Background="#CCDA373C" CornerRadius="6" Padding="5,4"
                                                            Opacity="{x:Bind VoiceMutedOpacity, Mode=OneWay}">
                                                        <FontIcon Glyph="&#xE720;" FontSize="11" Foreground="White" />
                                                    </Border>
                                                    <Border Background="#CCDA373C" CornerRadius="6" Padding="5,4"
                                                            Opacity="{x:Bind VoiceDeafenedOpacity, Mode=OneWay}">
                                                        <FontIcon Glyph="&#xE7F6;" FontSize="11" Foreground="White" />
                                                    </Border>
                                                </StackPanel>
                                            </Grid>
                                        </Border>

                                        <!-- Encadrement vert par-dessus toute la tuile quand le participant parle (comme sur Discord) -->
                                        <Border CornerRadius="16" BorderBrush="#23A55A" BorderThickness="3"
                                                Opacity="{x:Bind SpeakingRingOpacity, Mode=OneWay}"
                                                IsHitTestVisible="False" />
                                    </Grid>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>

                        <!-- Barre flottante de contrôles vocaux en bas de la vue vocale (Caméra, Partager l'écran Go Live, Micro, Casque, Krisp, Raccrocher) -->
                        <Border Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1"
                                CornerRadius="28" Padding="14,8">
                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                <Button Width="44" Height="44" CornerRadius="22" Padding="0"
                                        Click="OnToggleCameraClicked"
                                        Opacity="{x:Bind ViewModel.CameraOpacity, Mode=OneWay}"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.CameraTooltipText, Mode=OneWay}">
                                    <FontIcon Glyph="&#xE714;" FontSize="16" Foreground="{x:Bind ViewModel.CameraIconBrush, Mode=OneWay}" />
                                </Button>
                                <Button Height="44" CornerRadius="22" Padding="14,0"
                                        Click="OnScreenShareClicked"
                                        Opacity="{x:Bind ViewModel.ScreenShareOpacity, Mode=OneWay}"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.ScreenShareTooltipText, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE7F4;" FontSize="16" Foreground="{x:Bind ViewModel.ScreenShareIconBrush, Mode=OneWay}" />
                                        <TextBlock Text="Partager l'écran" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Width="44" Height="44" CornerRadius="22" Padding="0"
                                        Click="OnToggleMuteClicked" ToolTipService.ToolTip="Couper / Activer le micro">
                                    <FontIcon Glyph="&#xE720;" FontSize="16" Opacity="{x:Bind ViewModel.MuteOpacity, Mode=OneWay}" />
                                </Button>
                                <Button Width="44" Height="44" CornerRadius="22" Padding="0"
                                        Click="OnToggleDeafenClicked" ToolTipService.ToolTip="Mettre en sourdine">
                                    <FontIcon Glyph="&#xE7F6;" FontSize="16" Opacity="{x:Bind ViewModel.DeafenOpacity, Mode=OneWay}" />
                                </Button>
                                <Button Height="44" CornerRadius="22" Padding="14,0"
                                        Click="OnToggleKrispClicked"
                                        Opacity="{x:Bind ViewModel.KrispOpacity, Mode=OneWay}"
                                        ToolTipService.ToolTip="{x:Bind ViewModel.KrispTooltipText, Mode=OneWay}">
                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <FontIcon Glyph="&#xE9F5;" FontSize="16" Foreground="{x:Bind ViewModel.KrispIconBrush, Mode=OneWay}" />
                                        <TextBlock Text="Krisp" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Width="44" Height="44" CornerRadius="22" Padding="0" Background="#DA373C" BorderThickness="0"
                                        Click="OnDisconnectVoiceClicked" ToolTipService.ToolTip="Quitter le salon vocal">
                                    <FontIcon Glyph="&#xE711;" FontSize="15" Foreground="White" />
                                </Button>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- VUE TEXTUELLE (Messages complets : Réponses, Édition, Stickers, Fichiers, Sondages) -->
                    <ListView Grid.Row="1" Grid.Column="0" x:Name="MessageList"
                              Visibility="{x:Bind ViewModel.TextViewVisibility, Mode=OneWay}"
                              ItemsSource="{x:Bind ViewModel.Messages, Mode=OneWay}"
                              Padding="16,8"
                              ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:DiscordMessage">
                                <StackPanel Margin="0,2,0,6" Spacing="2">
                                    <StackPanel.ContextFlyout>
                                        <Flyout Placement="RightEdgeAlignedTop">
                                            <Flyout.FlyoutPresenterStyle>
                                                <Style TargetType="FlyoutPresenter">
                                                    <Setter Property="Padding" Value="6" />
                                                    <Setter Property="CornerRadius" Value="8" />
                                                    <Setter Property="Background" Value="#111214" />
                                                    <Setter Property="BorderBrush" Value="#2B2D31" />
                                                    <Setter Property="BorderThickness" Value="1" />
                                                    <Setter Property="MinWidth" Value="230" />
                                                    <Setter Property="MaxWidth" Value="250" />
                                                </Style>
                                            </Flyout.FlyoutPresenterStyle>
                                            <StackPanel Spacing="2" Tag="{x:Bind}">
                                                <!-- 1. Rangée horizontale de réactions rapides (👏, 👍, 😂, ❤️) -->
                                                <Border Background="#1E1F22" CornerRadius="8" Padding="4,2" Margin="2,2,2,4">
                                                    <Grid HorizontalAlignment="Stretch">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Button Grid.Column="0" Content="👏" FontSize="16" Height="32" Width="46" Padding="0"
                                                                Background="Transparent" BorderThickness="0" CornerRadius="6"
                                                                HorizontalAlignment="Center" Tag="{x:Bind}" Click="OnQuickReactClapClicked" />
                                                        <Button Grid.Column="1" Content="👍" FontSize="16" Height="32" Width="46" Padding="0"
                                                                Background="Transparent" BorderThickness="0" CornerRadius="6"
                                                                HorizontalAlignment="Center" Tag="{x:Bind}" Click="OnQuickReactThumbsUpClicked" />
                                                        <Button Grid.Column="2" Content="😂" FontSize="16" Height="32" Width="46" Padding="0"
                                                                Background="Transparent" BorderThickness="0" CornerRadius="6"
                                                                HorizontalAlignment="Center" Tag="{x:Bind}" Click="OnQuickReactJoyClicked" />
                                                        <Button Grid.Column="3" Content="❤️" FontSize="16" Height="32" Width="46" Padding="0"
                                                                Background="Transparent" BorderThickness="0" CornerRadius="6"
                                                                HorizontalAlignment="Center" Tag="{x:Bind}" Click="OnQuickReactHeartClicked" />
                                                    </Grid>
                                                </Border>

                                                <!-- 2. Add Reaction > -->
                                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                        Background="Transparent" BorderThickness="0" Padding="8,6" CornerRadius="4" Height="34" Margin="2,0" Tag="{x:Bind}">
                                                    <Button.Flyout>
                                                        <Flyout Placement="RightEdgeAlignedTop">
                                                            <Flyout.FlyoutPresenterStyle>
                                                                <Style TargetType="FlyoutPresenter">
                                                                    <Setter Property="Padding" Value="8" />
                                                                    <Setter Property="CornerRadius" Value="8" />
                                                                    <Setter Property="Background" Value="#111214" />
                                                                    <Setter Property="BorderBrush" Value="#2B2D31" />
                                                                    <Setter Property="BorderThickness" Value="1" />
                                                                </Style>
                                                            </Flyout.FlyoutPresenterStyle>
                                                            <StackPanel Width="180" Spacing="6" Tag="{x:Bind}">
                                                                <TextBlock Text="Réactions" FontSize="11" FontWeight="Bold" Opacity="0.6" Margin="4,0,0,2" />
                                                                <Grid HorizontalAlignment="Center">
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto" />
                                                                        <RowDefinition Height="Auto" />
                                                                        <RowDefinition Height="Auto" />
                                                                    </Grid.RowDefinitions>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="34" />
                                                                        <ColumnDefinition Width="34" />
                                                                        <ColumnDefinition Width="34" />
                                                                        <ColumnDefinition Width="34" />
                                                                        <ColumnDefinition Width="34" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Button Grid.Row="0" Grid.Column="0" Content="👍" FontSize="16" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="6" Tag="{x:Bind}" Click="OnQuickReactThumbsUpClicked" />
                                                                    <Button Grid.Row="0" Grid.Column="1" Content="❤️" FontSize="16" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="6" Tag="{x:Bind}" Click="OnQuickReactHeartClicked" />
                                                                    <Button Grid.Row="0" Grid.Column="2" Content="😂" FontSize="16" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="6" Tag="{x:Bind}" Click="OnQuickReactJoyClicked" />
                                                                    <Button Grid.Row="0" Grid.Column="3" Content="🔥" FontSize="16" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="6" Tag="{x:Bind}" Click="OnQuickReactFireClicked" />
                                                                    <Button Grid.Row="0" Grid.Column="4" Content="🎉" FontSize="16" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="6" Tag="{x:Bind}" Click="OnAddCustomReactionClicked" />

                                                                    <Button Grid.Row="1" Grid.Column="0" Content="💯" FontSize="16" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="6" Tag="{x:Bind}" Click="OnAddCustomReactionClicked" />
                                                                    <Button Grid.Row="1" Grid.Column="1" Content="😭" FontSize="16" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="6" Tag="{x:Bind}" Click="OnAddCustomReactionClicked" />
                                                                    <Button Grid.Row="1" Grid.Column="2" Content="🤔" FontSize="16" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="6" Tag="{x:Bind}" Click="OnAddCustomReactionClicked" />
                                                                    <Button Grid.Row="1" Grid.Column="3" Content="🙏" FontSize="16" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="6" Tag="{x:Bind}" Click="OnAddCustomReactionClicked" />
                                                                    <Button Grid.Row="1" Grid.Column="4" Content="👀" FontSize="16" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="6" Tag="{x:Bind}" Click="OnAddCustomReactionClicked" />

                                                                    <Button Grid.Row="2" Grid.Column="0" Content="🚀" FontSize="16" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="6" Tag="{x:Bind}" Click="OnAddCustomReactionClicked" />
                                                                    <Button Grid.Row="2" Grid.Column="1" Content="👏" FontSize="16" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="6" Tag="{x:Bind}" Click="OnQuickReactClapClicked" />
                                                                    <Button Grid.Row="2" Grid.Column="2" Content="✨" FontSize="16" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="6" Tag="{x:Bind}" Click="OnAddCustomReactionClicked" />
                                                                    <Button Grid.Row="2" Grid.Column="3" Content="⭐" FontSize="16" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="6" Tag="{x:Bind}" Click="OnAddCustomReactionClicked" />
                                                                    <Button Grid.Row="2" Grid.Column="4" Content="💀" FontSize="16" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="6" Tag="{x:Bind}" Click="OnAddCustomReactionClicked" />
                                                                </Grid>
                                                            </StackPanel>
                                                        </Flyout>
                                                    </Button.Flyout>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <FontIcon Grid.Column="0" Glyph="&#xED58;" FontSize="14" Opacity="0.85" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="Add Reaction" FontSize="13" VerticalAlignment="Center" />
                                                        <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Button>

                                                <!-- 3. Edit Message (Uniquement pour mes messages) -->
                                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                        Background="Transparent" BorderThickness="0" Padding="8,6" CornerRadius="4" Height="34" Margin="2,0"
                                                        Visibility="{x:Bind IsOwnMessage, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                        Tag="{x:Bind}" Click="OnEditMessageClicked">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <FontIcon Grid.Column="0" Glyph="&#xE70F;" FontSize="14" Opacity="0.85" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="Edit Message" FontSize="13" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Button>

                                                <!-- 4. Reply -->
                                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                        Background="Transparent" BorderThickness="0" Padding="8,6" CornerRadius="4" Height="34" Margin="2,0"
                                                        Tag="{x:Bind}" Click="OnReplyMessageClicked">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <FontIcon Grid.Column="0" Glyph="&#xE97A;" FontSize="14" Opacity="0.85" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="Reply" FontSize="13" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Button>

                                                <!-- 5. Forward -->
                                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                        Background="Transparent" BorderThickness="0" Padding="8,6" CornerRadius="4" Height="34" Margin="2,0"
                                                        Tag="{x:Bind}" Click="OnForwardMessageClicked">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <FontIcon Grid.Column="0" Glyph="&#xE72D;" FontSize="14" Opacity="0.85" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="Forward" FontSize="13" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Button>

                                                <!-- Ligne de séparation -->
                                                <Border Height="1" Background="#2B2D31" Margin="4,3" />

                                                <!-- 6. Copy Text -->
                                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                        Background="Transparent" BorderThickness="0" Padding="8,6" CornerRadius="4" Height="34" Margin="2,0"
                                                        Tag="{x:Bind}" Click="OnCopyMessageTextClicked">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <FontIcon Grid.Column="0" Glyph="&#xE8C8;" FontSize="14" Opacity="0.85" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="Copy Text" FontSize="13" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Button>

                                                <!-- 7. Pin Message -->
                                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                        Background="Transparent" BorderThickness="0" Padding="8,6" CornerRadius="4" Height="34" Margin="2,0"
                                                        Tag="{x:Bind}" Click="OnTogglePinMessageClicked">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <FontIcon Grid.Column="0" Glyph="&#xE718;" FontSize="14" Opacity="0.85" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="Pin Message" FontSize="13" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Button>

                                                <!-- 8. Bookmark Message -->
                                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                        Background="Transparent" BorderThickness="0" Padding="8,6" CornerRadius="4" Height="34" Margin="2,0"
                                                        Tag="{x:Bind}" Click="OnBookmarkMessageClicked">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <FontIcon Grid.Column="0" Glyph="&#xE8A4;" FontSize="14" Opacity="0.85" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="Bookmark Message" FontSize="13" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Button>

                                                <!-- 9. Create Reminder > -->
                                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                        Background="Transparent" BorderThickness="0" Padding="8,6" CornerRadius="4" Height="34" Margin="2,0" Tag="{x:Bind}">
                                                    <Button.Flyout>
                                                        <Flyout Placement="RightEdgeAlignedTop">
                                                            <Flyout.FlyoutPresenterStyle>
                                                                <Style TargetType="FlyoutPresenter">
                                                                    <Setter Property="Padding" Value="6" />
                                                                    <Setter Property="CornerRadius" Value="8" />
                                                                    <Setter Property="Background" Value="#111214" />
                                                                    <Setter Property="BorderBrush" Value="#2B2D31" />
                                                                    <Setter Property="BorderThickness" Value="1" />
                                                                    <Setter Property="MinWidth" Value="160" />
                                                                </Style>
                                                            </Flyout.FlyoutPresenterStyle>
                                                            <StackPanel Spacing="2" Tag="{x:Bind}">
                                                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Padding="8,6" CornerRadius="4" Tag="{x:Bind}" Content="In 20 minutes" Click="OnCreateReminder20mClicked" />
                                                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Padding="8,6" CornerRadius="4" Tag="{x:Bind}" Content="In 1 hour" Click="OnCreateReminder1hClicked" />
                                                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Padding="8,6" CornerRadius="4" Tag="{x:Bind}" Content="In 3 hours" Click="OnCreateReminder3hClicked" />
                                                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Padding="8,6" CornerRadius="4" Tag="{x:Bind}" Content="Tomorrow" Click="OnCreateReminderTomorrowClicked" />
                                                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Padding="8,6" CornerRadius="4" Tag="{x:Bind}" Content="Next week" Click="OnCreateReminderNextWeekClicked" />
                                                            </StackPanel>
                                                        </Flyout>
                                                    </Button.Flyout>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <FontIcon Grid.Column="0" Glyph="&#xE823;" FontSize="14" Opacity="0.85" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="Create Reminder" FontSize="13" VerticalAlignment="Center" />
                                                        <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Button>

                                                <!-- 10. Apps > -->
                                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                        Background="Transparent" BorderThickness="0" Padding="8,6" CornerRadius="4" Height="34" Margin="2,0" Tag="{x:Bind}">
                                                    <Button.Flyout>
                                                        <Flyout Placement="RightEdgeAlignedTop">
                                                            <Flyout.FlyoutPresenterStyle>
                                                                <Style TargetType="FlyoutPresenter">
                                                                    <Setter Property="Padding" Value="8" />
                                                                    <Setter Property="CornerRadius" Value="8" />
                                                                    <Setter Property="Background" Value="#111214" />
                                                                    <Setter Property="BorderBrush" Value="#2B2D31" />
                                                                    <Setter Property="BorderThickness" Value="1" />
                                                                </Style>
                                                            </Flyout.FlyoutPresenterStyle>
                                                            <StackPanel Width="170" Padding="4">
                                                                <TextBlock Text="No Apps Available" FontSize="12" Opacity="0.6" HorizontalAlignment="Center" />
                                                            </StackPanel>
                                                        </Flyout>
                                                    </Button.Flyout>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <FontIcon Grid.Column="0" Glyph="&#xEA86;" FontSize="14" Opacity="0.85" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="Apps" FontSize="13" VerticalAlignment="Center" />
                                                        <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="11" Opacity="0.6" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Button>

                                                <!-- 11. Mark Unread -->
                                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                        Background="Transparent" BorderThickness="0" Padding="8,6" CornerRadius="4" Height="34" Margin="2,0"
                                                        Tag="{x:Bind}" Click="OnMarkUnreadClicked">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <FontIcon Grid.Column="0" Glyph="&#xE715;" FontSize="14" Opacity="0.85" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="Mark Unread" FontSize="13" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Button>

                                                <!-- 12. Copy Message Link -->
                                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                        Background="Transparent" BorderThickness="0" Padding="8,6" CornerRadius="4" Height="34" Margin="2,0"
                                                        Tag="{x:Bind}" Click="OnCopyMessageLinkClicked">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <FontIcon Grid.Column="0" Glyph="&#xE71B;" FontSize="14" Opacity="0.85" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="Copy Message Link" FontSize="13" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Button>

                                                <!-- 13. Speak Message -->
                                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                        Background="Transparent" BorderThickness="0" Padding="8,6" CornerRadius="4" Height="34" Margin="2,0"
                                                        Tag="{x:Bind}" Click="OnSpeakMessageClicked">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <FontIcon Grid.Column="0" Glyph="&#xE767;" FontSize="14" Opacity="0.85" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="Speak Message" FontSize="13" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Button>

                                                <!-- Ligne de séparation avant Delete/Report -->
                                                <Border Height="1" Background="#2B2D31" Margin="4,3" />

                                                <!-- 14. Delete Message (Uniquement pour mes messages) -->
                                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                        Background="Transparent" BorderThickness="0" Padding="8,6" CornerRadius="4" Height="34" Margin="2,0"
                                                        Visibility="{x:Bind IsOwnMessage, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                        Tag="{x:Bind}" Click="OnDeleteMessageClicked">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <FontIcon Grid.Column="0" Glyph="&#xE74D;" FontSize="14" Foreground="#F23F43" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="Delete Message" FontSize="13" Foreground="#F23F43" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Button>

                                                <!-- 15. Report Message (Uniquement pour les messages des autres) -->
                                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                        Background="Transparent" BorderThickness="0" Padding="8,6" CornerRadius="4" Height="34" Margin="2,0"
                                                        Visibility="{x:Bind IsNotOwnMessage, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                        Tag="{x:Bind}" Click="OnReportMessageClicked">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <FontIcon Grid.Column="0" Glyph="&#xE7C1;" FontSize="14" Foreground="#F23F43" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="Report Message" FontSize="13" Foreground="#F23F43" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Button>

                                                <!-- Ligne de séparation -->
                                                <Border Height="1" Background="#2B2D31" Margin="4,3" />

                                                <!-- 16. Copy Message ID -->
                                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                        Background="Transparent" BorderThickness="0" Padding="8,6" CornerRadius="4" Height="34" Margin="2,0"
                                                        Tag="{x:Bind}" Click="OnCopyMessageIdClicked">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <FontIcon Grid.Column="0" Glyph="&#xE943;" FontSize="14" Opacity="0.85" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="Copy Message ID" FontSize="13" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Button>
                                            </StackPanel>
                                        </Flyout>
                                    </StackPanel.ContextFlyout>

                                    <!-- En-tête de réponse (ReferencedMessage) façon Discord / SakuraCord -->
                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="20,8,0,0"
                                                Visibility="{x:Bind IsReply, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <FontIcon Glyph="&#xE97A;" FontSize="11" Opacity="0.6" />
                                        <Ellipse Width="16" Height="16">
                                            <Ellipse.Fill>
                                                <ImageBrush ImageSource="{x:Bind ReplyAuthorAvatarUrl, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <TextBlock Text="{x:Bind ReplyAuthorName}" FontSize="12" FontWeight="SemiBold" Opacity="0.85" />
                                        <TextBlock Text="{x:Bind ReplyPreview}" FontSize="12" Opacity="0.65" TextTrimming="CharacterEllipsis" MaxWidth="420" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,4"
                                                Visibility="{x:Bind ShowNormalHeader, Converter={StaticResource BoolToVisibilityConverter}}">

                                        <!-- Bouton avatar avec Popout Profil ultra détaillé façon Discord (couleurs custom Nitro, Tag Clan + icône, bulle statut, serveurs/amis en commun) -->
                                        <Button Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="20" VerticalAlignment="Top"
                                                PointerEntered="OnAvatarPointerEntered" PointerExited="OnAvatarPointerExited"
                                                DoubleTapped="OnAvatarDoubleTapped" ToolTipService.ToolTip="Cliquez pour le mini-profil, double-cliquez pour la vue complète">
                                            <Button.Flyout>
                                                <Flyout Opening="OnUserProfileFlyoutOpening">
                                                    <Flyout.FlyoutPresenterStyle>
                                                        <Style TargetType="FlyoutPresenter">
                                                            <Setter Property="Padding" Value="0" />
                                                            <Setter Property="CornerRadius" Value="18" />
                                                            <Setter Property="MaxWidth" Value="350" />
                                                        </Style>
                                                    </Flyout.FlyoutPresenterStyle>
                                                    <Border Width="336" CornerRadius="18"
                                                            BorderBrush="{x:Bind Author.ProfileBorderColorHex, Mode=OneWay}"
                                                            BorderThickness="3"
                                                            Tag="{x:Bind Author}">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Color="{x:Bind Author.ProfilePrimaryColorHex, Mode=OneWay}" Offset="0.0" />
                                                                <GradientStop Color="{x:Bind Author.ProfileSecondaryColorHex, Mode=OneWay}" Offset="1.0" />
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                        <Grid>
                                                            <!-- Bannière (124px de haut, calée en haut, coins arrondis clippés) avec boutons d'actions -->
                                                            <Border Height="124" VerticalAlignment="Top" Background="{x:Bind Author.ProfilePrimaryColorHex, Mode=OneWay}" CornerRadius="15,15,0,0">
                                                                <Grid>
                                                                    <Border CornerRadius="15,15,0,0"
                                                                            Visibility="{x:Bind Author.HasBanner, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                        <Border.Background>
                                                                            <ImageBrush ImageSource="{x:Bind Author.BannerUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}"
                                                                                        Stretch="UniformToFill" AlignmentY="Center" AlignmentX="Center" />
                                                                        </Border.Background>
                                                                    </Border>
                                                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" Spacing="6">
                                                                        <Button Width="30" Height="30" Padding="0" CornerRadius="15"
                                                                                Background="#66000000" BorderThickness="0"
                                                                                ToolTipService.ToolTip="Ajouter en ami"
                                                                                Tag="{x:Bind Author}" Click="OnAddFriendFromPopoutClicked">
                                                                            <FontIcon Glyph="&#xE8FA;" FontSize="13" Foreground="#FFFFFF" />
                                                                        </Button>
                                                                        <Button Width="30" Height="30" Padding="0" CornerRadius="15"
                                                                                Background="#66000000" BorderThickness="0"
                                                                                ToolTipService.ToolTip="Plus d'options">
                                                                            <Button.Flyout>
                                                                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                                                    <MenuFlyoutItem Text="Voir le profil complet" Tag="{x:Bind Author}" Click="OnViewFullProfileFromPopoutClicked">
                                                                                        <MenuFlyoutItem.Icon>
                                                                                            <FontIcon Glyph="&#xE77B;" />
                                                                                        </MenuFlyoutItem.Icon>
                                                                                    </MenuFlyoutItem>
                                                                                    <MenuFlyoutItem Text="Partager le profil" Tag="{x:Bind Author}" Click="OnShareProfileFromPopoutClicked">
                                                                                        <MenuFlyoutItem.Icon>
                                                                                            <FontIcon Glyph="&#xE72D;" />
                                                                                        </MenuFlyoutItem.Icon>
                                                                                    </MenuFlyoutItem>
                                                                                    <MenuFlyoutItem Text="Shop This Look">
                                                                                        <MenuFlyoutItem.Icon>
                                                                                            <FontIcon Glyph="&#xE719;" />
                                                                                        </MenuFlyoutItem.Icon>
                                                                                    </MenuFlyoutItem>
                                                                                    <MenuFlyoutItem Text="Inviter sur le serveur" Tag="{x:Bind Author}" Click="OnInviteUserToGuildClicked">
                                                                                        <MenuFlyoutItem.Icon>
                                                                                            <FontIcon Glyph="&#xE8FA;" />
                                                                                        </MenuFlyoutItem.Icon>
                                                                                    </MenuFlyoutItem>
                                                                                    <MenuFlyoutSeparator />
                                                                                    <MenuFlyoutItem Text="Ignorer" Tag="{x:Bind Author}" Click="OnIgnoreUserClicked">
                                                                                        <MenuFlyoutItem.Icon>
                                                                                            <FontIcon Glyph="&#xE7BA;" />
                                                                                        </MenuFlyoutItem.Icon>
                                                                                    </MenuFlyoutItem>
                                                                                    <MenuFlyoutItem Text="Bloquer" Foreground="#F23F43" Tag="{x:Bind Author}" Click="OnBlockUserFromPopoutClicked">
                                                                                        <MenuFlyoutItem.Icon>
                                                                                            <FontIcon Glyph="&#xE72B;" Foreground="#F23F43" />
                                                                                        </MenuFlyoutItem.Icon>
                                                                                    </MenuFlyoutItem>
                                                                                    <MenuFlyoutItem Text="Signaler le profil d'utilisateur" Foreground="#F23F43" Tag="{x:Bind Author}" Click="OnReportUserClicked">
                                                                                        <MenuFlyoutItem.Icon>
                                                                                            <FontIcon Glyph="&#xE730;" Foreground="#F23F43" />
                                                                                        </MenuFlyoutItem.Icon>
                                                                                    </MenuFlyoutItem>
                                                                                    <MenuFlyoutSeparator />
                                                                                    <MenuFlyoutItem Text="Copier l'identifiant" Tag="{x:Bind Author}" Click="OnCopyUserIdFromPopoutClicked">
                                                                                        <MenuFlyoutItem.Icon>
                                                                                            <FontIcon Glyph="&#xE8C8;" />
                                                                                        </MenuFlyoutItem.Icon>
                                                                                    </MenuFlyoutItem>
                                                                                </MenuFlyout>
                                                                            </Button.Flyout>
                                                                            <FontIcon Glyph="&#xE712;" FontSize="13" Foreground="#FFFFFF" />
                                                                        </Button>
                                                                    </StackPanel>
                                                                </Grid>
                                                            </Border>

                                                            <!-- Avatar rond avec bordure assortie à la couleur principale du profil (cliquable pour ouvrir la vue complète) -->
                                                            <Button Padding="0" Background="Transparent" BorderThickness="0" CornerRadius="43"
                                                                    Margin="16,74,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                                    ToolTipService.ToolTip="Afficher le profil complet"
                                                                    Tag="{x:Bind Author}"
                                                                    Click="OnOpenFullUserProfileFromPopoutClicked">
                                                                <Ellipse Width="86" Height="86"
                                                                         StrokeThickness="6" Stroke="{x:Bind Author.ProfilePrimaryColorHex, Mode=OneWay}">
                                                                    <Ellipse.Fill>
                                                                        <ImageBrush ImageSource="{x:Bind Author.AvatarUrl, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                                    </Ellipse.Fill>
                                                                </Ellipse>
                                                            </Button>

                                                            <!-- Pastille de statut sur l'avatar -->
                                                            <Ellipse Width="22" Height="22" Margin="78,136,0,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                                     Fill="{x:Bind Author.StatusColor, Mode=OneWay}"
                                                                     Stroke="{x:Bind Author.ProfilePrimaryColorHex, Mode=OneWay}" StrokeThickness="4" />

                                                            <!-- Bulle de pensée Statut Personnalisé à droite de l'avatar (comme sur la capture Discord) -->
                                                            <Border Margin="112,110,14,0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                                    Background="#F2FFFFFF" CornerRadius="16" Padding="12,7"
                                                                    Visibility="{x:Bind Author.HasCustomStatus, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <TextBlock Text="{x:Bind Author.CustomStatusText, Mode=OneWay}"
                                                                           Foreground="#1E1F22" FontSize="12" FontWeight="Medium"
                                                                           TextTrimming="CharacterEllipsis" MaxWidth="185" />
                                                            </Border>

                                                            <!-- Corps du profil positionné proprement sous la bannière -->
                                                            <StackPanel Margin="16,168,16,16" Spacing="8">
                                                                <!-- Nom d'affichage en grand -->
                                                                <TextBlock Text="{x:Bind Author.DisplayName}"
                                                                           Foreground="{x:Bind Author.ProfileTextForegroundColorHex, Mode=OneWay}"
                                                                           FontWeight="Bold" FontSize="20" />

                                                                <!-- Ligne : username • pronoms [🐱 illit] + Badges officiels côte à côte -->
                                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                                    <TextBlock Text="{x:Bind Author.Username}"
                                                                               Foreground="{x:Bind Author.ProfileTextForegroundColorHex, Mode=OneWay}"
                                                                               Opacity="0.85" FontSize="13" VerticalAlignment="Center" />
                                                                    <TextBlock Text="•"
                                                                               Foreground="{x:Bind Author.ProfileTextForegroundColorHex, Mode=OneWay}"
                                                                               Opacity="0.55" FontSize="12" VerticalAlignment="Center"
                                                                               Visibility="{x:Bind Author.HasPronouns, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                    <TextBlock Text="{x:Bind Author.Pronouns, Mode=OneWay}"
                                                                               Foreground="{x:Bind Author.ProfileTextForegroundColorHex, Mode=OneWay}"
                                                                               Opacity="0.85" FontSize="13" VerticalAlignment="Center"
                                                                               Visibility="{x:Bind Author.HasPronouns, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                                                                    <!-- Tag de Clan / Serveur avec son icône (ex: 🐱 illit) -->
                                                                    <Border Visibility="{x:Bind Author.HasClan, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                            Background="{x:Bind Author.ProfilePillBackgroundColorHex, Mode=OneWay}"
                                                                            BorderBrush="#33FFFFFF"
                                                                            BorderThickness="1" CornerRadius="6" Padding="7,2" VerticalAlignment="Center">
                                                                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                            <Image Width="14" Height="14" Source="{x:Bind Author.ClanBadgeUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" Stretch="Uniform" />
                                                                            <TextBlock Text="{x:Bind Author.ClanTag, Mode=OneWay}"
                                                                                       Foreground="{x:Bind Author.ProfileTextForegroundColorHex, Mode=OneWay}"
                                                                                       FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                        </StackPanel>
                                                                    </Border>

                                                                    <!-- Badges officiels de l'utilisateur alignés sur la même ligne -->
                                                                    <ItemsControl ItemsSource="{x:Bind Author.Badges, Mode=OneWay}"
                                                                                  VerticalAlignment="Center"
                                                                                  Visibility="{x:Bind Author.HasBadges, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <StackPanel Orientation="Horizontal" Spacing="4" />
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate x:DataType="models:DiscordBadge">
                                                                                <Image Width="18" Height="18"
                                                                                       Source="{x:Bind IconUrl, Converter={StaticResource StringToImageSourceConverter}}"
                                                                                       ToolTipService.ToolTip="{x:Bind Description}"
                                                                                       Stretch="Uniform" />
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </StackPanel>

                                                                <!-- Ligne Mutual Friends • Mutual Servers -->
                                                                <TextBlock Text="{x:Bind Author.MutualSummaryText, Mode=OneWay}"
                                                                           Foreground="{x:Bind Author.ProfileTextForegroundColorHex, Mode=OneWay}"
                                                                           Opacity="0.78" FontSize="12" FontWeight="Medium"
                                                                           Visibility="{x:Bind Author.HasMutualInfo, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />

                                                                <!-- Carte Rich Presence (RPC) de l'utilisateur -->
                                                                <Border Visibility="{x:Bind Author.HasRichPresence, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                        Background="{x:Bind Author.ProfilePillBackgroundColorHex, Mode=OneWay}"
                                                                        BorderBrush="#22FFFFFF"
                                                                        BorderThickness="1" CornerRadius="10" Padding="10">
                                                                    <StackPanel Spacing="6">
                                                                        <TextBlock Text="{x:Bind Author.PrimaryActivity.HeaderLabel, Mode=OneWay}"
                                                                                   Foreground="{x:Bind Author.ProfileTextForegroundColorHex, Mode=OneWay}"
                                                                                   FontSize="10" FontWeight="Bold" Opacity="0.7" />
                                                                        <Grid ColumnSpacing="10">
                                                                            <Grid.ColumnDefinitions>
                                                                                <ColumnDefinition Width="Auto" />
                                                                                <ColumnDefinition Width="*" />
                                                                            </Grid.ColumnDefinitions>
                                                                            <Grid Grid.Column="0" Width="52" Height="52" VerticalAlignment="Top"
                                                                                  Visibility="{x:Bind Author.PrimaryActivity.HasLargeImage, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                                <Border Width="52" Height="52" CornerRadius="8">
                                                                                    <Border.Background>
                                                                                        <ImageBrush ImageSource="{x:Bind Author.PrimaryActivity.LargeImageUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                                                    </Border.Background>
                                                                                </Border>
                                                                                <Ellipse Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-3,-3"
                                                                                         Stroke="{ThemeResource CardBackgroundFillColorDefaultBrush}" StrokeThickness="2"
                                                                                         Visibility="{x:Bind Author.PrimaryActivity.HasSmallImage, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                                    <Ellipse.Fill>
                                                                                        <ImageBrush ImageSource="{x:Bind Author.PrimaryActivity.SmallImageUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                                                    </Ellipse.Fill>
                                                                                </Ellipse>
                                                                            </Grid>
                                                                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                                                                <TextBlock Text="{x:Bind Author.PrimaryActivity.Name, Mode=OneWay}"
                                                                                           Foreground="{x:Bind Author.ProfileTextForegroundColorHex, Mode=OneWay}"
                                                                                           FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                                                                <TextBlock Text="{x:Bind Author.PrimaryActivity.Details, Mode=OneWay}"
                                                                                           Foreground="{x:Bind Author.ProfileTextForegroundColorHex, Mode=OneWay}"
                                                                                           FontSize="11" Opacity="0.85" TextTrimming="CharacterEllipsis"
                                                                                           Visibility="{x:Bind Author.PrimaryActivity.HasDetails, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                                <TextBlock Text="{x:Bind Author.PrimaryActivity.State, Mode=OneWay}"
                                                                                           Foreground="{x:Bind Author.ProfileTextForegroundColorHex, Mode=OneWay}"
                                                                                           FontSize="11" Opacity="0.75" TextTrimming="CharacterEllipsis"
                                                                                           Visibility="{x:Bind Author.PrimaryActivity.HasState, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                                <TextBlock Text="{x:Bind Author.PrimaryActivity.ElapsedText, Mode=OneWay}" FontSize="11" Foreground="#23A55A" FontWeight="SemiBold"
                                                                                           Visibility="{x:Bind Author.PrimaryActivity.HasElapsed, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                            </StackPanel>
                                                                        </Grid>
                                                                    </StackPanel>
                                                                </Border>

                                                                <!-- Widget Game Collection de l'utilisateur -->
                                                                <Border Visibility="{x:Bind Author.HasGameWidgets, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                        Background="{x:Bind Author.ProfilePillBackgroundColorHex, Mode=OneWay}"
                                                                        BorderBrush="#22FFFFFF"
                                                                        BorderThickness="1" CornerRadius="10" Padding="10,8">
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <TextBlock Grid.Column="0" Text="Game Collection"
                                                                                   Foreground="{x:Bind Author.ProfileTextForegroundColorHex, Mode=OneWay}"
                                                                                   FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                        <ItemsControl Grid.Column="1" ItemsSource="{x:Bind Author.GameWidgets, Mode=OneWay}" VerticalAlignment="Center">
                                                                            <ItemsControl.ItemsPanel>
                                                                                <ItemsPanelTemplate>
                                                                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                                                                </ItemsPanelTemplate>
                                                                            </ItemsControl.ItemsPanel>
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate x:DataType="models:DiscordWidgetGame">
                                                                                    <Border Width="26" Height="26" CornerRadius="6" ToolTipService.ToolTip="{x:Bind TooltipText}">
                                                                                        <Border.Background>
                                                                                            <ImageBrush ImageSource="{x:Bind IconUrl, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                                                        </Border.Background>
                                                                                    </Border>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </Grid>
                                                                </Border>

                                                                <!-- Bio directe comme sur Discord -->
                                                                <TextBlock Text="{x:Bind Author.AboutMe, Mode=OneWay}"
                                                                           Foreground="{x:Bind Author.ProfileTextForegroundColorHex, Mode=OneWay}"
                                                                           FontSize="13" TextWrapping="Wrap" Opacity="0.92" />

                                                                <!-- Comptes et liens reliés affichés sur le profil de l'utilisateur -->
                                                                <StackPanel Spacing="6" Visibility="{x:Bind Author.HasConnectedAccounts, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                    <ItemsControl ItemsSource="{x:Bind Author.ConnectedAccounts, Mode=OneWay}">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <StackPanel Spacing="4" />
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate x:DataType="models:DiscordConnectedAccount">
                                                                                <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                                                        Background="#33000000"
                                                                                        BorderBrush="#22FFFFFF"
                                                                                        BorderThickness="1" CornerRadius="8" Padding="10,7"
                                                                                        Tag="{x:Bind}"
                                                                                        Click="OnConnectedAccountClicked"
                                                                                        ToolTipService.ToolTip="{x:Bind TooltipText}">
                                                                                    <Grid ColumnSpacing="8">
                                                                                        <Grid.ColumnDefinitions>
                                                                                            <ColumnDefinition Width="Auto" />
                                                                                            <ColumnDefinition Width="*" />
                                                                                            <ColumnDefinition Width="Auto" />
                                                                                        </Grid.ColumnDefinitions>
                                                                                        <Border Grid.Column="0" Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                                                                CornerRadius="6" Padding="6,2" VerticalAlignment="Center">
                                                                                            <TextBlock Text="{x:Bind PlatformBadgeText}" FontSize="11" FontWeight="Bold" />
                                                                                        </Border>
                                                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                                                                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                                                                <TextBlock Text="{x:Bind Name}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="165" />
                                                                                                <FontIcon Glyph="&#xE73E;" FontSize="11" Foreground="#23A55A" VerticalAlignment="Center"
                                                                                                          Visibility="{x:Bind Verified, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                                                          ToolTipService.ToolTip="Compte vérifié" />
                                                                                            </StackPanel>
                                                                                            <TextBlock Text="{x:Bind PlatformDisplayName}" FontSize="10" Opacity="0.6" />
                                                                                        </StackPanel>
                                                                                        <FontIcon Grid.Column="2" Glyph="&#xE8A7;" FontSize="12" Opacity="0.65" VerticalAlignment="Center"
                                                                                                  Visibility="{x:Bind HasUrl, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                                                    </Grid>
                                                                                </Button>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </StackPanel>

                                                                <!-- Rôles de l'utilisateur dans le serveur -->
                                                                <StackPanel Spacing="4" Visibility="{x:Bind Author.HasDisplayRoles, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                    <TextBlock Text="RÔLES" FontSize="10" FontWeight="Bold" Foreground="{x:Bind Author.ProfileTextForegroundColorHex, Mode=OneWay}" Opacity="0.7" />
                                                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                                                                  HorizontalScrollMode="Enabled" VerticalScrollMode="Disabled">
                                                                        <ItemsControl ItemsSource="{x:Bind Author.DisplayRoles, Mode=OneWay}">
                                                                            <ItemsControl.ItemsPanel>
                                                                                <ItemsPanelTemplate>
                                                                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                                                                </ItemsPanelTemplate>
                                                                            </ItemsControl.ItemsPanel>
                                                                            <ItemsControl.ItemTemplate>
                                                                                <DataTemplate x:DataType="models:DiscordRole">
                                                                                    <Border Background="#2b2d31" BorderBrush="#35373c" BorderThickness="1" CornerRadius="6" Padding="6,3">
                                                                                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                                                                                            <Ellipse Width="8" Height="8" Fill="{x:Bind ColorHex}" VerticalAlignment="Center" />
                                                                                            <TextBlock Text="{x:Bind Name}" FontSize="11" FontWeight="SemiBold" Foreground="#F2F3F5" VerticalAlignment="Center" />
                                                                                        </StackPanel>
                                                                                    </Border>
                                                                                </DataTemplate>
                                                                            </ItemsControl.ItemTemplate>
                                                                        </ItemsControl>
                                                                    </ScrollViewer>
                                                                </StackPanel>

                                                                <!-- Champ de message direct actif (Entrée pour envoyer un MP) -->
                                                                <Grid Margin="0,4,0,0">
                                                                    <TextBox PlaceholderText="{x:Bind Author.QuickMessagePlaceholder, Mode=OneWay}"
                                                                             Tag="{x:Bind Author}"
                                                                             KeyDown="OnQuickProfileMessageKeyDown"
                                                                             Background="{x:Bind Author.ProfilePillBackgroundColorHex, Mode=OneWay}"
                                                                             Foreground="{x:Bind Author.ProfileTextForegroundColorHex, Mode=OneWay}"
                                                                             BorderThickness="1"
                                                                             CornerRadius="8" Padding="10,6,34,6" FontSize="12" />
                                                                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                                                                            Margin="0,0,4,0" Padding="4"
                                                                            Background="Transparent" BorderThickness="0" CornerRadius="6"
                                                                            ToolTipService.ToolTip="Émojis">
                                                                        <FontIcon Glyph="&#xE76E;" FontSize="13" Foreground="#B5BAC1" />
                                                                    </Button>
                                                                </Grid>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </Flyout>
                                            </Button.Flyout>

                                            <!-- L'avatar affiché dans le message (cercle parfait) -->
                                            <Grid Width="40" Height="40">
                                                <Ellipse Fill="{ThemeResource ControlFillColorSecondaryBrush}" />
                                                <Ellipse>
                                                    <Ellipse.Fill>
                                                        <ImageBrush ImageSource="{x:Bind Author.AvatarUrl, Converter={StaticResource StringToImageSourceConverter}}" Stretch="UniformToFill" />
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                            </Grid>
                                        </Button>

                                        <StackPanel VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Author.DisplayName}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
                                                <!-- Pill Tag de Clan à côté du pseudo dans les messages (ex: 🐱 illit) -->
                                                <Border Visibility="{x:Bind Author.HasClan, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                        Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1" CornerRadius="5" Padding="5,1" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                                                        <Image Width="12" Height="12" Source="{x:Bind Author.ClanBadgeUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}" Stretch="Uniform" />
                                                        <TextBlock Text="{x:Bind Author.ClanTag, Mode=OneWay}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock Text="{x:Bind ShortTime}" Opacity="0.5" FontSize="12" VerticalAlignment="Center" />
                                                <TextBlock Text="{x:Bind EditedText}" Opacity="0.45" FontSize="11" VerticalAlignment="Center"
                                                           Visibility="{x:Bind IsEdited, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Message Système (Appel démarré, arrivée d'un membre, message épinglé, boost, etc. avec icône dédiée colorée style Discord) -->
                                    <StackPanel Orientation="Horizontal" Visibility="{x:Bind IsSystem, Converter={StaticResource BoolToVisibilityConverter}}" Spacing="12" Margin="14,6,0,6" VerticalAlignment="Center">
                                        <FontIcon Glyph="{x:Bind SystemIconGlyph}" Foreground="{x:Bind SystemIconColor}" FontSize="15" VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind SystemText}" Opacity="0.88" TextWrapping="Wrap" VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind ShortTime}" Opacity="0.45" FontSize="11" VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!-- Texte du message -->
                                    <TextBlock Text="{x:Bind Content}" TextWrapping="Wrap" Margin="50,0,0,0"
                                               IsTextSelectionEnabled="True"
                                               Visibility="{x:Bind HasContent, Converter={StaticResource BoolToVisibilityConverter}}" />

                                    <!-- Stickers Discord -->
                                    <ItemsControl ItemsSource="{x:Bind StickerItems}" Margin="50,4,0,0"
                                                  Visibility="{x:Bind HasStickers, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:DiscordStickerItem">
                                                <Image Source="{x:Bind Url, Converter={StaticResource StringToImageSourceConverter}}"
                                                       Width="140" Height="140" HorizontalAlignment="Left" Stretch="Uniform"
                                                       ToolTipService.ToolTip="{x:Bind Name}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Pièces jointes Images -->
                                    <ItemsControl ItemsSource="{x:Bind ImageAttachments}" Margin="50,4,0,0"
                                                  Visibility="{x:Bind HasImages, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:DiscordAttachment">
                                                <Border CornerRadius="8">
                                                    <Image Source="{x:Bind Url, Converter={StaticResource StringToImageSourceConverter}}"
                                                           MaxWidth="400" MaxHeight="300" HorizontalAlignment="Left" Margin="0,4" Stretch="Uniform" />
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Pièces jointes Fichiers non-image (ex: message.txt, zip, pdf) -->
                                    <ItemsControl ItemsSource="{x:Bind FileAttachments}" Margin="50,4,0,0"
                                                  Visibility="{x:Bind HasFiles, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:DiscordAttachment">
                                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,4" MaxWidth="360" HorizontalAlignment="Left">
                                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                                        <FontIcon Glyph="&#xE8A5;" FontSize="20" Opacity="0.8" />
                                                        <StackPanel VerticalAlignment="Center" Width="210">
                                                            <TextBlock Text="{x:Bind Filename}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{x:Bind SizeText}" FontSize="11" Opacity="0.6" />
                                                        </StackPanel>
                                                        <HyperlinkButton Content="Ouvrir" NavigateUri="{x:Bind Url}" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Sondages natifs Discord (Polls) -->
                                    <Border Margin="50,4,0,0" MaxWidth="380" HorizontalAlignment="Left"
                                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1" CornerRadius="10" Padding="12"
                                            Visibility="{x:Bind HasPoll, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <StackPanel Spacing="8">
                                            <TextBlock Text="{x:Bind Poll.QuestionText}" FontWeight="Bold" FontSize="14" TextWrapping="Wrap" />
                                            <ItemsControl ItemsSource="{x:Bind Poll.Answers}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:DiscordPollAnswer">
                                                        <Border Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="6" Padding="10,6" Margin="0,2">
                                                            <TextBlock Text="{x:Bind DisplayText}" FontSize="13" />
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- Embeds -->
                                    <ItemsControl ItemsSource="{x:Bind Embeds}" Margin="50,4,0,0"
                                                  Visibility="{x:Bind HasEmbeds, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:DiscordEmbed">
                                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,4" MaxWidth="400" HorizontalAlignment="Left">
                                                    <StackPanel Spacing="4">
                                                        <TextBlock Text="{x:Bind Provider.Name}" FontSize="12" Opacity="0.6" Visibility="{x:Bind HasProvider, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                        <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextWrapping="Wrap" Visibility="{x:Bind HasTitle, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                        <TextBlock Text="{x:Bind Description}" FontSize="12" TextWrapping="Wrap" Opacity="0.8" Visibility="{x:Bind HasDescription, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                        <Image Source="{x:Bind MainImageUrl, Converter={StaticResource StringToImageSourceConverter}}" MaxWidth="400" MaxHeight="300" Margin="0,8,0,0" Stretch="Uniform" Visibility="{x:Bind HasMainImage, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Réactions sous le message -->
                                    <ItemsControl ItemsSource="{x:Bind Reactions}" Margin="50,4,0,0"
                                                  Visibility="{x:Bind HasReactions, Converter={StaticResource BoolToVisibilityConverter}}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="6" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="models:DiscordReaction">
                                                <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                        BorderThickness="1" CornerRadius="8" Padding="6,3">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <TextBlock Text="{x:Bind EmojiText}" FontSize="13" />
                                                        <TextBlock Text="{x:Bind CountText}" FontSize="11" FontWeight="SemiBold" Opacity="0.8" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Panneau latéral droit : Activités récentes du serveur & Liste des Membres (En ligne / Hors ligne) -->
                    <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="1" Width="240"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1,0,0,0"
                            Visibility="{x:Bind ViewModel.MemberListVisibility, Mode=OneWay}">
                        <ScrollViewer Padding="8,10">
                            <StackPanel Spacing="12">
                                <!-- 1. SECTION ACTIVITÉ RÉCENTE -->
                                <StackPanel Spacing="6" Visibility="{x:Bind ViewModel.HasRecentMemberActivities, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Grid Margin="6,2,6,2">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <TextBlock Text="Activité" FontSize="11" FontWeight="Bold" Foreground="#949BA4" />
                                            <TextBlock Text="—" FontSize="11" FontWeight="Bold" Foreground="#949BA4" />
                                            <TextBlock Text="{x:Bind ViewModel.RecentMemberActivities.Count, Mode=OneWay}" FontSize="11" FontWeight="Bold" Foreground="#949BA4" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6" VerticalAlignment="Center">
                                            <FontIcon Glyph="&#xE713;" FontSize="11" Foreground="#949BA4" />
                                            <FontIcon Glyph="&#xE76C;" FontSize="11" Foreground="#949BA4" />
                                        </StackPanel>
                                    </Grid>

                                    <ItemsControl ItemsSource="{x:Bind ViewModel.RecentMemberActivities, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:MemberActivityCardViewModel">
                                                <Button Background="#1e1f22" BorderBrush="#2b2d31" BorderThickness="1"
                                                        CornerRadius="8" Padding="10,8" Margin="0,0,0,6"
                                                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                                        Tag="{x:Bind User}" Click="OnActivityCardClicked"
                                                        ToolTipService.ToolTip="{x:Bind TooltipText}">
                                                    <Button.Flyout>
                                                        <Flyout Opening="OnUserProfileFlyoutOpening" Placement="LeftEdgeAlignedTop">
                                                            <Flyout.FlyoutPresenterStyle>
                                                                <Style TargetType="FlyoutPresenter">
                                                                    <Setter Property="Padding" Value="0" />
                                                                    <Setter Property="CornerRadius" Value="16" />
                                                                    <Setter Property="MaxWidth" Value="340" />
                                                                    <Setter Property="MaxHeight" Value="620" />
                                                                    <Setter Property="Background" Value="Transparent" />
                                                                    <Setter Property="BorderThickness" Value="0" />
                                                                </Style>
                                                            </Flyout.FlyoutPresenterStyle>
                                                            <!-- Carte Popout de l'utilisateur actif -->
                                                            <Border Width="330" CornerRadius="16"
                                                                    Background="#1e1f22"
                                                                    BorderBrush="#35373c"
                                                                    BorderThickness="1"
                                                                    Tag="{x:Bind User}">
                                                                <Grid>
                                                                    <!-- Bannière -->
                                                                    <Border Height="110" VerticalAlignment="Top" CornerRadius="15,15,0,0">
                                                                        <Border.Background>
                                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                                <GradientStop Color="{x:Bind User.ProfilePrimaryColorHex, Mode=OneWay}" Offset="0.0" />
                                                                                <GradientStop Color="{x:Bind User.ProfileSecondaryColorHex, Mode=OneWay}" Offset="1.0" />
                                                                            </LinearGradientBrush>
                                                                        </Border.Background>
                                                                        <Grid>
                                                                            <Border CornerRadius="15,15,0,0"
                                                                                    Visibility="{x:Bind User.HasBanner, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                                <Border.Background>
                                                                                    <ImageBrush ImageSource="{x:Bind User.BannerUrl, Mode=OneWay, Converter={StaticResource StringToImageSourceConverter}}"
                                                                                                Stretch="UniformToFill" AlignmentY="Center" AlignmentX="Center" />
                                                                                </Border.Background>
                                                                            </Border>
                                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0" Spacing="6">
                                                                                <Button Width="30" Height="30" Padding="0" CornerRadius="15"
                                                                                        Background="#66000000" BorderThickness="0"
                                                                                        ToolTipService.ToolTip="Ajouter en ami"
                                                                                        Tag="{x:Bind User}" Click="OnAddFriendFromPopoutClicked">
                                                                                    <FontIcon Glyph="&#xE8FA;" FontSize="13" Foreground="#FFFFFF" />
                                                                                </Button>
                                                                                <Button Width="30" Height="30" Padding="0" CornerRadius="15"
                                                                                        Background="#66000000" BorderThickness="0"
                                                                                        ToolTipService.ToolTip="Plus d'options">
                                                                                    <Button.Flyout>
                                                                                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                                                            <MenuFlyoutItem Text="Voir le profil complet" Tag="{x:Bind User}" Click="OnViewFullProfileFromPopoutClicked">
                                                                                                <MenuFlyoutItem.Icon>
                                                                                                    <FontIcon Glyph="&#xE77B;" />
                                                                                                </MenuFlyoutItem.Icon>
                                                                                            </MenuFlyoutItem>
                                                                                            <MenuFlyoutItem Text="Partager le profil" Tag="{x:Bind User}" Click="OnShareProfileFromPopoutClicked">
                                                                                                <MenuFlyoutItem.Icon>
                                                                                                    <FontIcon Glyph="&#xE72D;" />
                                                                                                </MenuFlyoutItem.Icon>
                                                                                            </MenuFlyoutItem>
                                                                                            <MenuFlyoutItem Text="Shop This Look">
                                                                                                <MenuFlyoutItem.Icon>
                                                                                                    <FontIcon Glyph="&#xE719;" />
                                                                                                </MenuFlyoutItem.Icon>
                                                                                            </MenuFlyoutItem>
                                                                                            <MenuFlyoutItem Text="Inviter sur le serveur" Tag="{x:Bind User}" Click="OnInviteUserToGuildClicked">
                                                                                                <MenuFlyoutItem.Icon>
                                                                                                    <FontIcon Glyph="&#xE8FA;" />
                                                                                                </MenuFlyoutItem.Icon>
                                                                                            </MenuFlyoutItem>
                                                                                            <MenuFlyoutSeparator />
                                                                                            <MenuFlyoutItem Text="Ignorer" Tag="{x:Bind User}" Click="OnIgnoreUserClicked">
                                                                                                <MenuFlyoutItem.Icon>
                                                                                                    <FontIcon Glyph="&#xE7BA;" />
                                                                                                </MenuFlyoutItem.Icon>
                                                                                            </MenuFlyoutItem>
                                                                                            <MenuFlyoutItem Text="Bloquer" Foreground="#F23F43" Tag="{x:Bind User}" Click="OnBlockUserFromPopoutClicked">
                                                                                                <MenuFlyoutItem.Icon>
                                                                                                    <FontIcon Glyph="&#xE72B;" Foreground="#F23F43" />
                                                                                                </MenuFlyoutItem.Icon>
                                                                                            </MenuFlyoutItem>
