<Window
    x:Class="DiscordNative.Installer.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Barre de titre personnalisée (sans barre blanche) -->
        <Grid Grid.Row="0" x:Name="AppTitleBar" Background="Transparent" Padding="14,0">
            <TextBlock Text="Installateur Diswin" FontSize="12" Opacity="0.7" VerticalAlignment="Center" />
        </Grid>

        <Grid Grid.Row="1" Padding="32,12,32,28" RowSpacing="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Titre & Logo -->
            <StackPanel Grid.Row="0" Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                    <Border Width="48" Height="48" CornerRadius="12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1">
                        <Image Source="AppIcon.png" Stretch="UniformToFill" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="2">
                        <TextBlock x:Name="HeaderTitleText" Text="Installation de Diswin" FontSize="22" FontWeight="Bold" />
                        <TextBlock x:Name="HeaderSubtitleText" Text="Client Discord natif et ultra-léger pour Windows 11" FontSize="13" Opacity="0.6" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Options d'installation -->
            <StackPanel Grid.Row="1" Spacing="14" VerticalAlignment="Center">
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="12" Padding="20">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Dossier d'installation :" FontWeight="SemiBold" FontSize="14" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="InstallPathBox" CornerRadius="8" IsReadOnly="False" />
                            <Button Grid.Column="1" x:Name="BrowseButton" Content="Parcourir..." Click="OnBrowseClicked" CornerRadius="8" />
                        </Grid>

                        <StackPanel Spacing="4">
                            <CheckBox x:Name="DesktopShortcutCheck" Content="Créer un raccourci sur le Bureau" IsChecked="True" />
                            <CheckBox x:Name="StartMenuCheck" Content="Ajouter au Menu Démarrer" IsChecked="True" />
                            <CheckBox x:Name="StartupCheck" Content="Lancer Diswin au démarrage de Windows" IsChecked="False" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <ProgressBar x:Name="InstallProgress" IsIndeterminate="False" Minimum="0" Maximum="100" Value="0" Visibility="Collapsed" Height="6" CornerRadius="3" />
                <TextBlock x:Name="StatusText" Text="" Opacity="0.8" HorizontalAlignment="Center" FontSize="13" TextWrapping="Wrap" />
            </StackPanel>

            <!-- Boutons d'action -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Diswin v0.3.3" VerticalAlignment="Center" Opacity="0.5" FontSize="12" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                    <Button x:Name="CancelButton" Content="Annuler" Click="OnCancelClicked" CornerRadius="8" />
                    <Button x:Name="UninstallButton" Content="Désinstaller" Click="OnUninstallClicked" Visibility="Collapsed" CornerRadius="8"
                            Background="#C42B1C" Foreground="White" />
                    <Button x:Name="InstallButton" Content="Installer maintenant" Click="OnInstallClicked" Style="{StaticResource AccentButtonStyle}" CornerRadius="8" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
